<%# app/views/purchasing/purchase_invoices/_form.html.erb %>
<%= form_with model: [:purchasing, invoice], local: true, id: 'invoice-form' do |f| %>

  <% if invoice.errors.any? %>
    <div class="flash alert" style="margin-bottom:20px">
      <strong><%= invoice.errors.count %> error(s):</strong>
      <ul style="margin-top:6px;padding-left:16px">
        <% invoice.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%# ══ SUPPLIER TYPE SELECTOR (new invoices only) ══════════════════════ %>
  <%
    existing_hint = invoice.purchase_invoice_items.first&.metadata&.dig('supplier_hint').to_s
    is_new = invoice.new_record?
  %>
  <input type="hidden" id="supplier-hint-field" name="supplier_hint"
         value="<%= existing_hint %>">

  <% if is_new %>
    <div id="supplier-selector"
         style="background:var(--surface);border:1px solid var(--border);
                border-radius:12px;padding:24px;margin-bottom:20px">
      <div style="font-size:13px;font-weight:700;color:var(--text);margin-bottom:6px">
        What type of bill is this?
      </div>
      <div style="font-size:12px;color:var(--text-dim);margin-bottom:18px">
        Select the supplier type — this determines how products are matched and searched.
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
        <% [
          ['asian_paints',    'Asian Paints',    'Material code + description matching', '#ef4444', 'AP'],
          ['shalimar_paints', 'Shalimar Paints', 'Code + description matching',          '#f97316', 'SP'],
          ['',                'Others',          'Description matching',                  '#6b7280', '○'],
        ].each do |hint, label, sublabel, col, icon| %>
          <div class="supplier-type-card"
               data-hint="<%= hint %>"
               onclick="selectSupplierType('<%= hint %>')"
               style="border:2px solid var(--border);border-radius:10px;padding:16px 18px;
                      cursor:pointer;transition:all .15s;position:relative">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
              <span style="width:32px;height:32px;border-radius:8px;
                           background:rgba(<%= col.gsub('#','').scan(/../).map{|c|c.to_i(16)}.join(',') %>,0.12);
                           border:1px solid rgba(<%= col.gsub('#','').scan(/../).map{|c|c.to_i(16)}.join(',') %>,0.35);
                           display:flex;align-items:center;justify-content:center;
                           font-size:11px;font-weight:800;color:<%= col %>"><%= icon %></span>
              <span style="font-size:14px;font-weight:700;color:var(--text)"><%= label %></span>
            </div>
            <div style="font-size:11px;color:var(--text-dim)"><%= sublabel %></div>
            <div class="selected-check"
                 style="display:none;position:absolute;top:10px;right:12px;
                        width:20px;height:20px;border-radius:50%;background:var(--success);
                        align-items:center;justify-content:center;font-size:11px;color:#0f172a">✓</div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Invoice body — hidden on new until supplier type is selected %>
  <div id="invoice-body"
       style="<%= is_new ? 'display:none' : '' %>">

  <%# ══════════════════════════════════════════════════════
      SECTION 1 — Supplier & Bill Details
  ══════════════════════════════════════════════════════ %>
  <div class="form-card" style="max-width:100%;margin-bottom:20px">
    <div class="form-section">
      <div class="form-section-title">Supplier & Bill Details</div>

      <div class="form-row" style="grid-template-columns:1fr 1fr 1fr">

        <div class="form-group">
          <%= f.label :supplier_id, "Supplier" %>
          <%= f.hidden_field :supplier_id, id: 'supplier_id_field', value: invoice.supplier_id %>
          <div style="position:relative" id="supplier-ac-wrap">
            <input type="text" id="supplier-search-input"
                   placeholder="Search supplier name or GSTIN…"
                   autocomplete="off"
                   value="<%= invoice.supplier&.name %>"
                   style="width:100%;background:var(--bg);border:1px solid var(--border);
                          border-radius:6px;padding:9px 12px;color:var(--text);
                          font-size:13.5px;outline:none">
            <div id="supplier-ac-dropdown"
                 style="display:none;position:absolute;top:100%;left:0;right:0;z-index:99999;
                        background:var(--surface);border:1px solid var(--border);
                        border-radius:6px;box-shadow:var(--shadow-lg);
                        max-height:240px;overflow-y:auto;margin-top:2px"></div>
          </div>
          <div id="supplier-info-strip"
               style="font-family:var(--mono);font-size:10px;color:var(--text-dim);
                      margin-top:4px;min-height:14px">
            <% if invoice.supplier %>
              <% s = invoice.supplier %>
              <%= [s.gstin.presence&.prepend("GSTIN: "), s.state.presence, s.pan.presence&.prepend("PAN: ")].compact.join('  ·  ') %>
            <% end %>
          </div>
          <div style="font-size:11px;color:var(--text-dim);margin-top:4px">
            Not listed?
            <a href="#" onclick="showSupplierPanel(event)" style="color:var(--accent);text-decoration:none">
              Add supplier inline
            </a>
          </div>
        </div>

        <div class="form-group">
          <%= f.label :invoice_number, "Bill Number" %>
          <%= f.text_field :invoice_number, placeholder: 'e.g. WB2401437256',
                style: 'font-family:var(--mono)', class: 'form-control' %>
          <div class="form-hint">As printed on the supplier bill — optional</div>
        </div>

        <div class="form-group">
          <%= f.label :invoice_date, "Bill Date" %>
          <%= f.date_field :invoice_date, class: 'form-control' %>
        </div>
      </div>

      <div class="form-row" style="grid-template-columns:1fr 2fr">
        <div class="form-group">
          <%= f.label :delivery_date, "Delivery Date *" %>
          <%= f.date_field :delivery_date, class: 'form-control',
                value: invoice.delivery_date || Date.today %>
          <% if invoice.errors[:delivery_date].any? %>
            <div class="form-error"><%= invoice.errors[:delivery_date].first %></div>
          <% end %>
        </div>

        <div class="form-group">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <span style="font-size:12px;font-weight:500;color:var(--text-dim)">Additional Info</span>
            <button type="button" onclick="addMetaRow()"
                    style="background:var(--accent-dim);color:var(--accent);
                           border:1px solid var(--accent);border-radius:4px;padding:2px 10px;
                           font-size:11px;cursor:pointer;font-family:var(--mono)">+ Add Field</button>
          </div>
          <div id="meta-rows" style="display:flex;flex-direction:column;gap:8px;margin-top:6px">
            <% (invoice.metadata || {}).except('irn','ack_number','delivery_number','reverse_charge').each do |key, val| %>
              <div class="meta-row" style="display:flex;gap:8px;align-items:center">
                <input type="text" name="purchase_invoice[metadata][<%= key %>]" value="<%= key %>"
                       placeholder="Key"
                       style="width:140px;background:var(--bg);border:1px solid var(--border);
                              border-radius:5px;padding:7px 10px;color:var(--text);
                              font-family:var(--mono);font-size:12px;outline:none">
                <input type="text" name="purchase_invoice[metadata][<%= key %>]" value="<%= val %>"
                       placeholder="Value"
                       style="flex:1;background:var(--bg);border:1px solid var(--border);
                              border-radius:5px;padding:7px 10px;color:var(--text);
                              font-size:13px;outline:none">
                <button type="button" onclick="this.closest('.meta-row').remove()"
                        style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:16px;padding:4px">×</button>
              </div>
            <% end %>
          </div>
          <div class="form-hint">Store extra details like IRN, ACK number, delivery note, etc.</div>
        </div>
      </div>
    </div>
  </div>

  <%# ══════════════════════════════════════════════════════
      INLINE SUPPLIER PANEL
  ══════════════════════════════════════════════════════ %>
  <div id="supplier-panel"
       style="display:none;background:var(--surface);border:1px solid var(--accent);
              border-radius:10px;padding:20px;margin-bottom:20px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <div style="font-family:var(--mono);font-size:11px;letter-spacing:0.1em;
                  text-transform:uppercase;color:var(--accent)">Add / Find Supplier</div>
      <button type="button" onclick="hideSupplierPanel()"
              style="background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:20px;line-height:1;padding:0 4px">×</button>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:14px">
      <div>
        <label style="display:block;font-size:12px;font-weight:500;color:var(--text-dim);margin-bottom:5px" for="sp-name">Name *</label>
        <input type="text" id="sp-name" placeholder="Supplier name"
               style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px 10px;color:var(--text);font-size:13px;outline:none">
      </div>
      <div>
        <label style="display:block;font-size:12px;font-weight:500;color:var(--text-dim);margin-bottom:5px" for="sp-gstin">GSTIN</label>
        <input type="text" id="sp-gstin" placeholder="e.g. 19AAACA3622K1ZS"
               style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px 10px;color:var(--text);font-family:var(--mono);font-size:12px;outline:none">
      </div>
      <div>
        <label style="display:block;font-size:12px;font-weight:500;color:var(--text-dim);margin-bottom:5px" for="sp-pan">PAN</label>
        <input type="text" id="sp-pan" placeholder="e.g. AAACA3622K"
               style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px 10px;color:var(--text);font-family:var(--mono);font-size:12px;outline:none">
      </div>
      <div>
        <label style="display:block;font-size:12px;font-weight:500;color:var(--text-dim);margin-bottom:5px" for="sp-state">State</label>
        <input type="text" id="sp-state" placeholder="e.g. West Bengal"
               style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px 10px;color:var(--text);font-size:13px;outline:none">
      </div>
      <div>
        <label style="display:block;font-size:12px;font-weight:500;color:var(--text-dim);margin-bottom:5px" for="sp-state-code">State Code</label>
        <input type="text" id="sp-state-code" placeholder="e.g. 19"
               style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px 10px;color:var(--text);font-family:var(--mono);font-size:12px;outline:none">
      </div>
      <div style="grid-column:1/-1">
        <label style="display:block;font-size:12px;font-weight:500;color:var(--text-dim);margin-bottom:5px" for="sp-address">Address</label>
        <textarea id="sp-address" placeholder="Full address — building, street, city, PIN…"
                  rows="2"
                  style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:8px 10px;color:var(--text);font-size:12.5px;outline:none;resize:vertical"></textarea>
      </div>
    </div>
    <div id="sp-matches" style="display:none;margin-bottom:14px">
      <div style="font-size:11px;color:var(--text-dim);margin-bottom:6px">Existing suppliers found — click to use:</div>
      <div id="sp-match-list" style="display:flex;flex-wrap:wrap;gap:6px"></div>
    </div>
    <div id="sp-error" style="display:none;color:var(--danger);font-size:12px;margin-bottom:10px"></div>
    <div style="display:flex;gap:10px;align-items:center">
      <button type="button" id="sp-save-btn" onclick="saveSupplierInline()"
              style="background:var(--accent);color:#fff;border:none;border-radius:6px;padding:8px 18px;font-size:13px;font-weight:500;cursor:pointer">
        Save &amp; Use Supplier
      </button>
      <button type="button" onclick="hideSupplierPanel()"
              style="background:transparent;color:var(--text-dim);border:1px solid var(--border);border-radius:6px;padding:8px 16px;font-size:13px;cursor:pointer">Cancel</button>
      <span id="sp-saving" style="display:none;font-size:12px;color:var(--text-dim);font-family:var(--mono)">Saving…</span>
    </div>
  </div>

  <%# ══════════════════════════════════════════════════════
      SECTION 2 — Line Items Grid
  ══════════════════════════════════════════════════════ %>
  <div style="background:var(--surface);border:1px solid var(--border);
              border-radius:10px;overflow:hidden;margin-bottom:20px">

    <div style="padding:14px 20px;border-bottom:1px solid var(--border);
                display:flex;align-items:center;justify-content:space-between">
      <div style="font-family:var(--mono);font-size:11px;letter-spacing:0.1em;
                  text-transform:uppercase;color:var(--text-dim)">Bill Items</div>
      <button type="button" onclick="addItemRow()"
              style="background:var(--accent-dim);color:var(--accent);border:1px solid var(--accent);
                     border-radius:5px;padding:5px 14px;font-size:12px;cursor:pointer;font-family:var(--mono)">
        + Add Row
      </button>
    </div>

    <div style="overflow-x:auto;min-height:350px">
      <table style="width:100%;border-collapse:collapse" id="items-table">
        <thead>
          <tr style="background:var(--bg)">
            <%
              ths = [
                ["Product",     "min-width:240px", "left"],
                ["UOM",         "width:55px",       "center"],
                ["Qty",         "width:85px",       "right"],
                ["Unit Rate",   "width:95px",       "right"],
                ["Disc %",      "width:75px",       "right"],
                ["Pre-GST",     "width:100px",      "right"],
                ["GST",         "width:90px",       "right"],
                ["Payable (₹)", "width:115px",      "right"],
                ["",            "width:36px",       "center"],
              ]
            %>
            <% ths.each do |label, w, align| %>
              <th style="padding:9px 10px;text-align:<%= align %>;font-family:var(--mono);
                         font-size:10px;letter-spacing:0.07em;text-transform:uppercase;
                         color:var(--text-dim);border-bottom:1px solid var(--border);<%= w %>">
                <%= label %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody id="items-tbody">
          <%= f.fields_for :purchase_invoice_items do |item_f| %>
            <%# On edit, skip unsaved blank rows (new_record? with no description/product) %>
            <%# On new, render all rows including blank starter rows %>
            <% item = item_f.object %>
            <% skip = !invoice.new_record? &&
                      item.new_record? &&
                      item.product_id.blank? &&
                      item.total_amount.to_f == 0 %>
            <%= render 'item_row', f: item_f, item: item unless skip %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div style="padding:12px 20px;border-top:1px solid var(--border);
                display:flex;justify-content:flex-end;align-items:flex-end;gap:32px;flex-wrap:wrap">
      <div style="text-align:right">
        <div style="font-family:var(--mono);font-size:10px;letter-spacing:0.08em;
                    text-transform:uppercase;color:var(--text-dim);margin-bottom:4px">Total Items</div>
        <div style="font-family:var(--mono);font-size:16px;font-weight:600" id="total-items">0</div>
      </div>
      <%# Stated invoice total (from the printed invoice) — reconciliation target %>
      <div style="text-align:right">
        <div style="font-family:var(--mono);font-size:10px;letter-spacing:0.08em;
                    text-transform:uppercase;color:var(--text-dim);margin-bottom:4px">Bill Total (printed)</div>
        <input type="number" id="stated-invoice-total"
               name="purchase_invoice[metadata][stated_invoice_total]"
               value="<%= invoice.metadata['stated_invoice_total'] %>"
               placeholder="0.00" min="0" step="0.01"
               style="width:130px;background:var(--bg);border:1px solid var(--border);
                      border-radius:5px;padding:7px 10px;color:var(--text);
                      font-family:var(--mono);font-size:14px;outline:none;text-align:right">
      </div>
      <div style="text-align:right">
        <div style="font-family:var(--mono);font-size:10px;letter-spacing:0.08em;
                    text-transform:uppercase;color:var(--text-dim);margin-bottom:4px">Grand Total (₹)</div>
        <div style="font-family:var(--mono);font-size:20px;font-weight:700;color:var(--accent)"
             id="grand-total">0.00</div>
        <div id="reconcile-status"
             style="font-family:var(--mono);font-size:11px;font-weight:600;margin-top:3px;display:none"></div>
      </div>
    </div>
  </div>

  <%# ══ PRE-SAVE REVIEW PANEL ═══════════════════════════════════════════ %>
  <div id="invoice-review-panel"
       style="background:var(--surface);border:1px solid var(--border);
              border-radius:10px;padding:14px 20px;margin-bottom:16px;
              display:none">
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;
                color:var(--text-dim);margin-bottom:10px">Bill Summary</div>
    <div style="display:flex;gap:20px;flex-wrap:wrap;margin-bottom:10px">
      <div id="review-matched"
           style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--success)">
        <span style="width:18px;height:18px;border-radius:50%;background:rgba(74,222,128,0.15);
                     display:flex;align-items:center;justify-content:center;font-size:10px">✓</span>
        <span id="review-matched-count">0</span> matched to catalogue
      </div>
      <div id="review-unmatched"
           style="display:none;display:flex;align-items:center;gap:6px;font-size:13px;color:var(--warning)">
        <span style="width:18px;height:18px;border-radius:50%;background:rgba(247,195,79,0.15);
                     display:flex;align-items:center;justify-content:center;font-size:10px">⚠</span>
        <span id="review-unmatched-count">0</span> new product(s) → will go to <strong>Product Review</strong>
      </div>
    </div>
    <div id="review-unmatched-list" style="display:none;margin-top:6px">
      <div style="font-size:11px;color:var(--text-dim);margin-bottom:4px">New products to review:</div>
      <div id="review-unmatched-names"
           style="font-size:12px;color:var(--warning);font-family:var(--mono);
                  line-height:1.8"></div>
    </div>
  </div>

  <div style="display:flex;gap:12px;align-items:center">
    <%= f.submit invoice.new_record? ? 'Save Draft' : 'Update Bill',
          id: 'invoice-submit-btn',
          class: 'btn btn-primary' %>
    <%= link_to 'Cancel',
          invoice.new_record? ? purchasing_purchase_invoices_path : purchasing_purchase_invoice_path(invoice),
          class: 'btn btn-secondary' %>
    <span style="font-size:12px;color:var(--text-dim)">
      Saved as draft. Confirm from detail view to update stock.
    </span>
  </div>

  </div><%# /invoice-body %>

<% end %>

<%# ══════════════════════════════════════════════════════
    ROW TEMPLATE — new blank rows added by JS
══════════════════════════════════════════════════════ %>
<template id="item-row-template">
  <tr data-row="INDEX" style="border-bottom:1px solid var(--border)">
    <td style="padding:8px 12px;min-width:240px">
      <div class="autocomplete-wrap" style="position:relative">
        <input type="hidden"
               name="purchase_invoice[purchase_invoice_items_attributes][INDEX][product_id]"
               class="product-id-input" value="">
        <%# These three fields MUST live inside .autocomplete-wrap so wrap.querySelector() finds them %>
        <input type="hidden" class="raw-desc-field"
               name="purchase_invoice[purchase_invoice_items_attributes][INDEX][metadata][raw_description]" value="">
        <input type="hidden" class="supplier-hint-field"
               name="purchase_invoice[purchase_invoice_items_attributes][INDEX][metadata][supplier_hint]" value="">
        <input type="hidden" class="material-code-hidden"
               name="purchase_invoice[purchase_invoice_items_attributes][INDEX][metadata][material_code]" value="">
        <input type="text" class="product-search-input"
               placeholder="Search product by name…" autocomplete="off"
               style="width:100%;background:var(--bg);border:1px solid var(--border);
                      border-radius:5px;padding:6px 9px;color:var(--text);font-size:12.5px;outline:none">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:3px">
          <div class="product-meta-line"
               style="font-family:var(--mono);font-size:10px;color:var(--text-dim);min-height:13px"></div>
          <div class="match-status-badge"
               style="display:none;align-items:center;padding:2px 7px;border-radius:4px;
                      border:1px solid var(--border);font-size:10px;font-weight:700"></div>
        </div>
        <div class="ac-dropdown"
             style="display:none;position:absolute;top:100%;left:0;right:0;z-index:9999;
                    background:var(--surface);border:1px solid var(--border);border-radius:6px;
                    box-shadow:var(--shadow-lg);max-height:260px;overflow-y:auto;margin-top:2px"></div>
      </div>
    </td>
    <td class="uom-cell"
        style="padding:8px 10px;font-family:var(--mono);font-size:11px;color:var(--text-dim);
               white-space:nowrap;text-align:center">—</td>
    <td style="padding:6px 8px">
      <input type="number" class="qty-input"
             name="purchase_invoice[purchase_invoice_items_attributes][INDEX][quantity]"
             placeholder="0" min="0" step="0.001"
             style="width:80px;background:var(--bg);border:1px solid var(--border);
                    border-radius:5px;padding:6px 8px;color:var(--text);
                    font-family:var(--mono);font-size:12.5px;outline:none;text-align:right">
    </td>
    <%# Hidden fields for proper columns — synced by recalcRow, finalised by confirm! %>
    <input type="hidden" class="taxable-field"
           name="purchase_invoice[purchase_invoice_items_attributes][INDEX][taxable_amount]" value="">
    <input type="hidden" class="tax-field"
           name="purchase_invoice[purchase_invoice_items_attributes][INDEX][tax_amount]" value="">
    <input type="hidden" class="disc-pct-field"
           name="purchase_invoice[purchase_invoice_items_attributes][INDEX][discount_percent]" value="">
    <input type="hidden" class="disc-amt-field"
           name="purchase_invoice[purchase_invoice_items_attributes][INDEX][discount_amount]" value="">
    <td style="padding:6px 8px">
      <input type="number" class="rate-input"
             name="purchase_invoice[purchase_invoice_items_attributes][INDEX][unit_rate]"
             placeholder="0.00" min="0" step="any"
             style="width:90px;background:var(--bg);border:1px solid var(--border);
                    border-radius:5px;padding:6px 8px;color:var(--text);
                    font-family:var(--mono);font-size:12.5px;outline:none;text-align:right">
    </td>
    <td style="padding:6px 8px">
      <input type="number" class="discount-input"
             name="purchase_invoice[purchase_invoice_items_attributes][INDEX][metadata][discount_percent]"
             placeholder="0" min="0" max="100" step="0.01"
             style="width:70px;background:var(--bg);border:1px solid var(--border);
                    border-radius:5px;padding:6px 8px;color:var(--text);
                    font-family:var(--mono);font-size:12.5px;outline:none;text-align:right">
    </td>
    <td style="padding:6px 8px;text-align:right;font-family:var(--mono);font-size:12px;color:var(--text-dim)">
      <span class="total-pre-display">—</span>
    </td>
    <td style="padding:6px 8px;text-align:right">
      <input type="number" class="gst-rate-input"
             name="purchase_invoice[purchase_invoice_items_attributes][INDEX][gst_rate]"
             placeholder="0" min="0" max="100" step="0.01"
             style="width:60px;background:var(--bg);border:1px solid var(--border);
                    border-radius:5px;padding:5px 7px;color:var(--text);
                    font-family:var(--mono);font-size:11px;outline:none;text-align:right">
      <div style="font-family:var(--mono);font-size:9px;color:var(--text-dim);text-align:center;margin-top:1px">GST %</div>
      <div class="gst-display" style="font-family:var(--mono);font-size:12px;color:var(--text-dim);margin-top:4px">
        —<span class="gst-breakdown" style="display:none"></span>
      </div>
    </td>
    <td style="padding:6px 8px">
      <input type="hidden" class="total-input"
             name="purchase_invoice[purchase_invoice_items_attributes][INDEX][total_amount]"
             value="">
      <input type="number" class="total-editable"
             placeholder="0.00" min="0" step="0.01"
             style="width:110px;background:var(--bg);border:1px solid var(--border);
                    border-radius:5px;padding:6px 8px;color:var(--text);
                    font-family:var(--mono);font-size:12.5px;outline:none;
                    text-align:right;font-weight:600">
    </td>
    <td style="padding:6px 8px;text-align:center">
      <button type="button" onclick="deleteRow(this)"
              style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:18px;line-height:1;padding:2px 4px">×</button>
    </td>
  </tr>
</template>

<%# ══════════════════════════════════════════════════════
    JAVASCRIPT
══════════════════════════════════════════════════════ %>
<script>
(function() {

  var rowIndex = document.querySelectorAll('#items-tbody tr[data-row]').length;

  // ══════════════════════════════════════════════════════════════
  //  HELPERS
  // ══════════════════════════════════════════════════════════════
  function escHtml(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function selectedProductIds() {
    var ids = new Set();
    document.querySelectorAll('#items-tbody tr[data-row]').forEach(function(r) {
      if (r.style.display === 'none') return;
      var f = r.querySelector('.product-id-input');
      if (f && f.value) ids.add(String(f.value));
    });
    return ids;
  }

  // Get discount from row 1 (the first visible row)
  function getRow1Discount() {
    var first = document.querySelector('#items-tbody tr[data-row]:not([style*="display:none"])');
    if (!first) return '';
    var d = first.querySelector('.discount-input');
    return d ? d.value : '';
  }

  // ══════════════════════════════════════════════════════════════
  //  ROW CALCULATIONS — taxable-driven (same identity as digitise review)
  //  User fills: qty, unit_rate, discount%, gst%
  //  Computed : taxable = qty×rate×(1−disc%) ; total = taxable×(1+gst%)
  // ══════════════════════════════════════════════════════════════
  function recalcRow(row) {
    var qtyEl  = row.querySelector('.qty-input');
    var rateEl = row.querySelector('.rate-input');
    if (!qtyEl || !rateEl) return;

    var qty     = parseFloat(qtyEl.value)  || 0;
    var rate    = parseFloat(rateEl.value) || 0;

    var gstRateEl = row.querySelector('.gst-rate-input');
    var discEl    = row.querySelector('.discount-input');
    var gstPct    = gstRateEl ? (parseFloat(gstRateEl.value) || 0) : 0;
    var discPct   = discEl    ? (parseFloat(discEl.value)    || 0) : 0;

    var gross    = (qty * rate).round2();
    var discAmt  = discPct > 0 ? (gross * discPct / 100).round2() : 0;
    var totalPre = (gross - discAmt).round2();         // taxable (pre-GST)
    var gstAmt   = gstPct > 0 ? (totalPre * gstPct / 100).round2() : 0;
    var payable  = (totalPre + gstAmt).round2();       // total incl GST

    // Write computed total into the editable total field + hidden mirror
    var totalEl    = row.querySelector('.total-editable');
    var totalInput = row.querySelector('.total-input');
    if (totalEl)    totalEl.value    = payable > 0 ? payable.toFixed(2) : '';
    if (totalInput) totalInput.value = payable > 0 ? payable.toFixed(2) : '';

    // Pre-GST (taxable) display
    var preDsp = row.querySelector('.total-pre-display');
    if (preDsp) preDsp.textContent = totalPre > 0
      ? totalPre.toLocaleString('en-IN', {minimumFractionDigits: 2}) : '—';

    // GST display
    var gstDsp = row.querySelector('.gst-display');
    if (gstDsp) gstDsp.textContent = gstAmt > 0
      ? gstAmt.toLocaleString('en-IN', {minimumFractionDigits: 2}) : '—';
    var gstBrk = row.querySelector('.gst-breakdown');
    if (gstBrk) gstBrk.textContent = gstPct > 0 ? '(' + gstPct.toFixed(0) + '%)' : '';

    // Discount amount label
    var discLbl = row.querySelector('.disc-amt-label');
    if (discLbl) discLbl.textContent = discAmt > 0 ? '₹' + discAmt.toFixed(2) : '';

    // ── Sync proper-column hidden fields (finalised by confirm!) ──────────
    var taxableField = row.querySelector('.taxable-field');
    var taxField     = row.querySelector('.tax-field');
    var discPctField = row.querySelector('.disc-pct-field');
    var discAmtField = row.querySelector('.disc-amt-field');
    if (taxableField) taxableField.value = totalPre > 0 ? totalPre.toFixed(2) : '';
    if (taxField)     taxField.value     = gstAmt  > 0 ? gstAmt.toFixed(2)  : '';
    if (discPctField) discPctField.value = discPct > 0 ? discPct.toFixed(2) : '';
    if (discAmtField) discAmtField.value = discAmt > 0 ? discAmt.toFixed(2) : '';

    validateRow(row);
    updateGrandTotal();
  }

  // Rounding helpers
  Number.prototype.round2 = function() { return Math.round(this * 100) / 100; };
  Number.prototype.round4 = function() { return Math.round(this * 10000) / 10000; };

  function updateGrandTotal() {
    var total = 0, count = 0;
    document.querySelectorAll('#items-tbody tr[data-row]').forEach(function(row) {
      if (row.style.display === 'none') return;
      var ti = row.querySelector('.total-input');
      var t  = ti ? (parseFloat(ti.value) || 0) : 0;
      if (t > 0) { total += t; count++; }
    });
    document.getElementById('grand-total').textContent =
      total.toLocaleString('en-IN', {minimumFractionDigits: 2});
    document.getElementById('total-items').textContent = count;
    updateReconcile(total);
  }

  // ── Reconciliation vs the printed invoice total (same tolerances as digitise) ──
  function updateReconcile(computed) {
    var statedEl = document.getElementById('stated-invoice-total');
    var statusEl = document.getElementById('reconcile-status');
    if (!statusEl) return;
    var stated = statedEl ? (parseFloat(statedEl.value) || 0) : 0;
    if (stated <= 0) { statusEl.style.display = 'none'; return; }

    var diff = Math.abs(computed - stated);
    statusEl.style.display = 'block';
    if (diff <= 1.5) {
      statusEl.textContent = '✓ Matches invoice total';
      statusEl.style.color = 'var(--success)';
    } else if (diff <= 10.0) {
      statusEl.textContent = '⚠ Off by ₹' + diff.toFixed(2) + ' (rounding?)';
      statusEl.style.color = 'var(--warning)';
    } else {
      statusEl.textContent = '✗ Off by ₹' + diff.toLocaleString('en-IN', {minimumFractionDigits: 2});
      statusEl.style.color = 'var(--danger)';
    }
  }

  // ── Per-row validation — flags a manually-overridden total that no longer
  //    equals qty×rate×(1−disc%)×(1+gst%). Mirrors the digitise row check.
  function validateRow(row) {
    var qtyEl  = row.querySelector('.qty-input');
    var rateEl = row.querySelector('.rate-input');
    var totEl  = row.querySelector('.total-editable');
    if (!qtyEl || !rateEl || !totEl) return;

    var qty   = parseFloat(qtyEl.value)  || 0;
    var rate  = parseFloat(rateEl.value) || 0;
    var gstEl = row.querySelector('.gst-rate-input');
    var dEl   = row.querySelector('.discount-input');
    var gst   = gstEl ? (parseFloat(gstEl.value) || 0) : 0;
    var disc  = dEl   ? (parseFloat(dEl.value)   || 0) : 0;
    var total = parseFloat(totEl.value) || 0;

    var bad = false;
    if (qty > 0 && rate > 0 && total > 0) {
      var taxable  = (qty * rate * (1 - disc / 100)).round2();
      var expected = (taxable * (1 + gst / 100)).round2();
      bad = Math.abs(expected - total) > 1.0;
    }
    row.dataset.invalid = bad ? '1' : '0';
    row.style.background = bad ? 'rgba(239,68,68,0.10)' : '';
    if (totEl) totEl.style.borderColor = bad ? 'var(--danger)' : 'var(--border)';
  }

  function wireRowEvents(row) {
    // Guard — skip if essential inputs missing (e.g. blank/destroyed rows)
    var qtyEl  = row.querySelector('.qty-input');
    var rateEl = row.querySelector('.rate-input');
    if (!qtyEl || !rateEl) return;

    // Taxable-driven: qty / rate / gst% / disc% all recompute the total
    qtyEl.addEventListener('input',  function() { recalcRow(row); });
    rateEl.addEventListener('input', function() { recalcRow(row); });
    var gstRateEl = row.querySelector('.gst-rate-input');
    if (gstRateEl) gstRateEl.addEventListener('input', function() { recalcRow(row); });

    // Manual override of the computed total — just sync the hidden mirror and
    // refresh the grand total; do NOT reverse-compute rate/taxable.
    var totalEl = row.querySelector('.total-editable');
    if (totalEl) totalEl.addEventListener('input', function() {
      var t  = parseFloat(this.value) || 0;
      var hi = row.querySelector('.total-input');
      if (hi) hi.value = t > 0 ? t.toFixed(2) : '';
      validateRow(row);
      updateGrandTotal();
    });

    // discount change on row 1 → push to all subsequent rows, then recompute each
    var discEl = row.querySelector('.discount-input');
    if (discEl) discEl.addEventListener('input', function() {
      var rows = document.querySelectorAll('#items-tbody tr[data-row]');
      if (row === rows[0]) {
        var val = this.value;
        for (var i = 1; i < rows.length; i++) {
          if (rows[i].style.display === 'none') continue;
          var d = rows[i].querySelector('.discount-input');
          if (d) { d.value = val; recalcRow(rows[i]); }
        }
      }
      recalcRow(row);
    });
  }

  // ══════════════════════════════════════════════════════════════
  //  PRODUCT AUTOCOMPLETE
  // ══════════════════════════════════════════════════════════════
  function setupProductAutocomplete(row) {
    var wrap     = row.querySelector('.autocomplete-wrap');
    if (!wrap) return;
    var input    = wrap.querySelector('.product-search-input');
    var idField  = wrap.querySelector('.product-id-input');
    var dropdown = wrap.querySelector('.ac-dropdown');
    var metaLine = wrap.querySelector('.product-meta-line');
    var uomCell  = row.querySelector('.uom-cell');
    if (!input || !idField || !dropdown) return;

    var timer;
    input.addEventListener('input', function() {
      idField.value = '';
      if (metaLine) metaLine.textContent = '';
      // Keep raw description in sync so unmatched items save their name
      var rawDescField = wrap.querySelector('.raw-desc-field');
      if (rawDescField) rawDescField.value = this.value.trim();
      // Typed value is just a name now — a real code is only stored when a
      // catalogue product is matched (applyMatchToRow). Clear stale code.
      var mcHidden = wrap.querySelector('.material-code-hidden');
      if (mcHidden) mcHidden.value = '';
      updateRowMatchBadge(row, false, this.value.trim());
      updateReviewPanel();
      scheduleAutoMatch(row);    // live AP/Shalimar code match from this one field
      clearTimeout(timer);
      var q = this.value.trim();
      if (q.length < 2) { dropdown.style.display = 'none'; return; }
      timer = setTimeout(function() {
        var hint = document.getElementById('supplier-hint-field')?.value || '';
        var url  = '/purchasing/purchase_invoices/product_search?q=' + encodeURIComponent(q) +
                   (hint ? '&supplier_hint=' + encodeURIComponent(hint) : '');
        fetch(url, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
          .then(function(r) { return r.json(); })
          .then(function(results) {
            renderProductDropdown(results, wrap, input, idField, dropdown, metaLine, uomCell, row);
          })
          .catch(function() { dropdown.style.display = 'none'; });
      }, 200);
    });

    input.addEventListener('blur', function() {
      setTimeout(function() { dropdown.style.display = 'none'; }, 200);
    });
  }

  function renderProductDropdown(results, wrap, input, idField, dropdown, metaLine, uomCell, row) {
    dropdown.innerHTML = '';
    var used     = selectedProductIds();
    used.delete(String(idField.value));
    var filtered = results.filter(function(p) { return !used.has(String(p.id)); });

    if (filtered.length === 0) {
      dropdown.innerHTML =
        '<div style="padding:10px 14px;color:var(--text-dim);font-size:13px">' +
        (results.length > 0 ? 'All matching products already added' : 'No products found') +
        '</div>';
      dropdown.style.display = 'block';
      return;
    }

    filtered.forEach(function(p) {
      var metaParts = [];
      if (p.material_code) metaParts.push('M: ' + p.material_code);
      if (p.pack_code)     metaParts.push('Pack: ' + p.pack_code);

      var el = document.createElement('div');
      el.style.cssText = 'padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--border)';
      el.innerHTML =
        '<div style="font-size:13px;font-weight:500;color:var(--text)">' + escHtml(p.label) + '</div>' +
        (metaParts.length > 0
          ? '<div style="font-family:var(--mono);font-size:10px;color:var(--text-dim);margin-top:2px">' +
              escHtml(metaParts.join('  ·  ')) + '</div>'
          : '');

      el.addEventListener('mouseover', function() { this.style.background = 'var(--border)'; });
      el.addEventListener('mouseout',  function() { this.style.background = ''; });
      el.addEventListener('mousedown', function(e) {
        e.preventDefault();
        input.value   = p.label;
        idField.value = p.id;
        if (uomCell)  uomCell.textContent  = p.uom || '—';
        if (metaLine) metaLine.textContent = metaParts.join('  ·  ');

        // Set editable GST rate from product catalogue
        var gstRateInp = row.querySelector('.gst-rate-input');
        if (p.gst_rate != null && gstRateInp) gstRateInp.value = p.gst_rate;
        // Clear the unmatched description — product is now linked
        var rawDescField = wrap.querySelector('.raw-desc-field');
        if (rawDescField) rawDescField.value = '';
        // Update match status badge
        updateRowMatchBadge(row, true, p.label);
        // Trigger recalc so taxable/tax fields get populated immediately
        recalcRow(row);
        dropdown.style.display = 'none';
        updateReviewPanel();
      });
      dropdown.appendChild(el);
    });
    dropdown.style.display = 'block';
  }

  // ══════════════════════════════════════════════════════════════
  //  ADD / DELETE ROWS
  // ══════════════════════════════════════════════════════════════
  window.addItemRow = function() {
    var tmpl = document.getElementById('item-row-template').content.cloneNode(true);
    var row  = tmpl.querySelector('tr');
    var idx  = rowIndex++;
    row.innerHTML = row.innerHTML.replace(/INDEX/g, idx);
    row.setAttribute('data-row', idx);
    document.getElementById('items-tbody').appendChild(row);

    // Stamp current supplier_hint into the new row's hidden field
    var hint = document.getElementById('supplier-hint-field')?.value || '';
    var hf = row.querySelector('.supplier-hint-field');
    if (hf) hf.value = hint;
    // Show/hide material code field based on supplier
    applySupplierUiToRow(row, hint);

    // Copy discount from row 1
    var disc = getRow1Discount();
    if (disc) {
      var d = row.querySelector('.discount-input');
      if (d) d.value = disc;
    }

    setupProductAutocomplete(row);
    wireRowEvents(row);
  };

  // ══════════════════════════════════════════════════════════════
  //  LIVE AUTO-MATCH — same supplier matchers as the digitise screen
  //  AP: material_code · Shalimar: product_code(+pack) · Generic: description
  //  One field now: its value is sent as BOTH code and description, and the
  //  matcher picks whichever applies for the supplier.
  // ══════════════════════════════════════════════════════════════
  var _matchTimers = {};
  function scheduleAutoMatch(row) {
    var idx = row.getAttribute('data-row');
    clearTimeout(_matchTimers[idx]);
    _matchTimers[idx] = setTimeout(function() { tryAutoMatch(row); }, 300);
  }

  function tryAutoMatch(row) {
    var hint   = document.getElementById('supplier-hint-field') ?
                 document.getElementById('supplier-hint-field').value : '';
    var srchEl = row.querySelector('.product-search-input');
    var val    = srchEl ? srchEl.value.trim() : '';
    if (val.length < 2) return;

    var qs = 'supplier_hint=' + encodeURIComponent(hint) +
             '&material_code=' + encodeURIComponent(val) +
             '&description='   + encodeURIComponent(val);
    fetch('/purchasing/purchase_invoices/match_product?' + qs,
          { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data && data.matched && data.product) applyMatchToRow(row, data.product);
        else                                      clearAutoMatch(row);
      })
      .catch(function() {});
  }

  function applyMatchToRow(row, p) {
    var idField = row.querySelector('.product-id-input');
    if (idField) idField.value = p.id;

    var uomCell = row.querySelector('.uom-cell');
    if (uomCell) uomCell.textContent = p.uom || '—';

    // Pull GST rate from the catalogue only if the user hasn't typed one
    var gstEl = row.querySelector('.gst-rate-input');
    if (gstEl && p.gst_rate != null && !gstEl.value) { gstEl.value = p.gst_rate; }

    // Fill the search box with the canonical catalogue description (stays editable)
    var srchEl = row.querySelector('.product-search-input');
    if (srchEl && (p.description || p.label)) srchEl.value = p.description || p.label;

    var rawDesc = row.querySelector('.raw-desc-field');
    if (rawDesc) rawDesc.value = '';   // matched → not an unmatched new product

    // Store the catalogue product's real code (AP material_code / Shalimar product_code)
    var mcHidden = row.querySelector('.material-code-hidden');
    if (mcHidden) mcHidden.value = p.material_code || p.product_code || '';

    var meta = row.querySelector('.product-meta-line');
    if (meta) {
      var parts = [];
      if (p.material_code) parts.push('M: ' + p.material_code);
      if (p.product_code)  parts.push('PC: ' + p.product_code);
      if (p.pack_code)     parts.push('Pack: ' + p.pack_code);
      meta.textContent = parts.join('  ·  ');
    }
    updateRowMatchBadge(row, true, p.description || p.label);
    recalcRow(row);
    updateReviewPanel();
  }

  function clearAutoMatch(row) {
    // Code no longer resolves to a catalogue product → mark as new/unmatched,
    // but keep whatever the user has typed.
    var idField = row.querySelector('.product-id-input');
    if (idField && idField.value) {
      idField.value = '';
      var srchEl = row.querySelector('.product-search-input');
      updateRowMatchBadge(row, false, srchEl ? srchEl.value.trim() : '');
      updateReviewPanel();
    }
  }

  // ══════════════════════════════════════════════════════════════
  //  SUPPLIER TYPE SELECTION
  // ══════════════════════════════════════════════════════════════
  window.selectSupplierType = function(hint) {
    // Update hidden field
    document.getElementById('supplier-hint-field').value = hint;

    // Update card styles
    document.querySelectorAll('.supplier-type-card').forEach(function(card) {
      var selected = card.getAttribute('data-hint') === hint;
      card.style.borderColor      = selected ? 'var(--accent)' : 'var(--border)';
      card.style.background       = selected ? 'rgba(79,142,247,0.06)' : '';
      var check = card.querySelector('.selected-check');
      if (check) check.style.display = selected ? 'flex' : 'none';
    });

    // Show invoice body
    document.getElementById('invoice-body').style.display = '';

    // Apply UI changes to all existing rows
    document.querySelectorAll('#items-tbody tr[data-row]').forEach(function(row) {
      var hf = row.querySelector('.supplier-hint-field');
      if (hf) hf.value = hint;
      applySupplierUiToRow(row, hint);
    });
  };

  function applySupplierUiToRow(row, hint) {
    // Single field: just adjust its placeholder to hint that a code also works.
    var srch = row.querySelector('.product-search-input');
    if (!srch) return;
    if (hint === 'asian_paints')         srch.placeholder = 'Material code or product name…';
    else if (hint === 'shalimar_paints') srch.placeholder = 'Product code or product name…';
    else                                 srch.placeholder = 'Search product by name…';
  }

  // ══════════════════════════════════════════════════════════════
  //  ROW MATCH STATUS BADGE
  // ══════════════════════════════════════════════════════════════
  function updateRowMatchBadge(row, matched, label) {
    var badge = row.querySelector('.match-status-badge');
    if (!badge) return;
    if (!label || label.trim() === '') {
      badge.style.display = 'none';
      return;
    }
    badge.style.display = 'flex';
    if (matched) {
      badge.innerHTML = '<span style="color:var(--success);font-size:10px;font-weight:700">✓ Matched</span>';
      badge.style.background = 'rgba(74,222,128,0.08)';
      badge.style.borderColor = 'rgba(74,222,128,0.25)';
    } else {
      badge.innerHTML = '<span style="color:var(--warning);font-size:10px;font-weight:700">⚠ New product</span>';
      badge.style.background = 'rgba(247,195,79,0.08)';
      badge.style.borderColor = 'rgba(247,195,79,0.25)';
    }
  }

  // ══════════════════════════════════════════════════════════════
  //  REVIEW PANEL
  // ══════════════════════════════════════════════════════════════
  function updateReviewPanel() {
    var rows        = document.querySelectorAll('#items-tbody tr[data-row]');
    var matchedList = [], unmatchedList = [];

    rows.forEach(function(row) {
      if (row.style.display === 'none') return; // deleted rows
      var idField   = row.querySelector('.product-id-input');
      var rawField  = row.querySelector('.raw-desc-field');
      var hasId     = idField && idField.value.trim() !== '';
      var hasRaw    = rawField && rawField.value.trim() !== '';
      if (hasId)       matchedList.push(true);
      else if (hasRaw) unmatchedList.push(rawField.value.trim());
    });

    var panel = document.getElementById('invoice-review-panel');
    if (matchedList.length === 0 && unmatchedList.length === 0) {
      panel.style.display = 'none';
      return;
    }
    panel.style.display = '';

    document.getElementById('review-matched-count').textContent = matchedList.length;
    var unmatchedEl = document.getElementById('review-unmatched');
    unmatchedEl.style.display = unmatchedList.length > 0 ? 'flex' : 'none';
    document.getElementById('review-unmatched-count').textContent = unmatchedList.length;

    var listWrap = document.getElementById('review-unmatched-list');
    listWrap.style.display = unmatchedList.length > 0 ? '' : 'none';
    document.getElementById('review-unmatched-names').innerHTML =
      unmatchedList.map(function(n) { return '· ' + escHtml(n); }).join('<br>');
  }

  window.deleteRow = function(btn) {
    var row = btn.closest('tr');
    var di  = row.querySelector('.destroy-input');
    if (di) { di.value = '1'; row.style.display = 'none'; }
    else    { row.remove(); }
    updateGrandTotal();
    updateReviewPanel();
  };

  // ══════════════════════════════════════════════════════════════
  //  SUPPLIER AUTOCOMPLETE
  // ══════════════════════════════════════════════════════════════
  var supplierDebounce;
  document.getElementById('supplier-search-input').addEventListener('input', function() {
    var q = this.value.trim();
    document.getElementById('supplier_id_field').value = '';
    document.getElementById('supplier-info-strip').textContent = '';
    clearTimeout(supplierDebounce);
    if (q.length < 2) { document.getElementById('supplier-ac-dropdown').style.display = 'none'; return; }
    supplierDebounce = setTimeout(function() {
      fetch('/purchasing/suppliers/search?q=' + encodeURIComponent(q), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function(r) { return r.json(); })
        .then(function(results) { renderSupplierDropdown(results); })
        .catch(function() {});
    }, 200);
  });

  document.getElementById('supplier-search-input').addEventListener('blur', function() {
    setTimeout(function() { document.getElementById('supplier-ac-dropdown').style.display = 'none'; }, 200);
  });

  function renderSupplierDropdown(results) {
    var dd = document.getElementById('supplier-ac-dropdown');
    dd.innerHTML = '';
    if (results.length === 0) {
      dd.innerHTML = '<div style="padding:10px 14px;color:var(--text-dim);font-size:13px">No suppliers found — ' +
        '<a href="#" onclick="showSupplierPanel(event)" style="color:var(--accent)">add one</a></div>';
      dd.style.display = 'block'; return;
    }
    results.forEach(function(s) {
      var el = document.createElement('div');
      el.style.cssText = 'padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--border)';
      var meta = [s.gstin ? 'GSTIN: ' + s.gstin : null, s.state].filter(Boolean).join('  ·  ');
      el.innerHTML =
        '<div style="font-size:13px;font-weight:500;color:var(--text)">' + escHtml(s.name) + '</div>' +
        (meta ? '<div style="font-family:var(--mono);font-size:10px;color:var(--text-dim);margin-top:2px">' + escHtml(meta) + '</div>' : '');
      el.addEventListener('mouseover', function() { this.style.background = 'var(--border)'; });
      el.addEventListener('mouseout',  function() { this.style.background = ''; });
      el.addEventListener('mousedown', function(e) { e.preventDefault(); selectSupplier(s); dd.style.display = 'none'; });
      dd.appendChild(el);
    });
    dd.style.display = 'block';
  }

  function selectSupplier(s) {
    document.getElementById('supplier-search-input').value = s.name;
    document.getElementById('supplier_id_field').value = s.id;
    var parts = [];
    if (s.gstin)   parts.push('GSTIN: ' + s.gstin);
    if (s.state)   parts.push(s.state);
    if (s.pan)     parts.push('PAN: ' + s.pan);
    if (s.address) parts.push(s.address);
    document.getElementById('supplier-info-strip').textContent = parts.join('  ·  ');
  }

  // ══════════════════════════════════════════════════════════════
  //  INLINE SUPPLIER PANEL
  // ══════════════════════════════════════════════════════════════
  window.showSupplierPanel = function(e) {
    if (e) e.preventDefault();
    var q = document.getElementById('supplier-search-input').value.trim();
    if (q) document.getElementById('sp-name').value = q;
    document.getElementById('supplier-panel').style.display = 'block';
    document.getElementById('sp-name').focus();
  };
  window.hideSupplierPanel = function() {
    document.getElementById('supplier-panel').style.display = 'none';
    document.getElementById('sp-error').style.display = 'none';
    document.getElementById('sp-matches').style.display = 'none';
  };

  var spDebounce;
  document.getElementById('sp-name').addEventListener('input', function() {
    clearTimeout(spDebounce);
    var q = this.value.trim();
    if (q.length < 2) { document.getElementById('sp-matches').style.display = 'none'; return; }
    spDebounce = setTimeout(function() {
      fetch('/purchasing/suppliers/search?q=' + encodeURIComponent(q), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function(r) { return r.json(); })
        .then(function(results) {
          if (!results.length) { document.getElementById('sp-matches').style.display = 'none'; return; }
          var list = document.getElementById('sp-match-list');
          list.innerHTML = '';
          results.forEach(function(s) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.style.cssText = 'background:var(--accent-dim);color:var(--accent);border:1px solid var(--accent);border-radius:5px;padding:5px 12px;font-size:12px;cursor:pointer;font-family:var(--mono)';
            btn.textContent = s.name + (s.gstin ? ' · ' + s.gstin : '');
            btn.addEventListener('click', function() { selectSupplier(s); hideSupplierPanel(); });
            list.appendChild(btn);
          });
          document.getElementById('sp-matches').style.display = 'block';
        });
    }, 300);
  });

  window.saveSupplierInline = function() {
    var name = document.getElementById('sp-name').value.trim();
    var errEl = document.getElementById('sp-error');
    errEl.style.display = 'none';
    if (!name) { errEl.textContent = 'Supplier name is required.'; errEl.style.display = 'block'; return; }
    var savingEl = document.getElementById('sp-saving');
    savingEl.style.display = 'inline';
    document.getElementById('sp-save-btn').disabled = true;
    fetch('/purchasing/suppliers', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json',
                 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
                 'Accept': 'application/json' },
      body: JSON.stringify({ supplier: {
        name:       name,
        gstin:      document.getElementById('sp-gstin').value.trim(),
        pan:        document.getElementById('sp-pan').value.trim(),
        state:      document.getElementById('sp-state').value.trim(),
        state_code: document.getElementById('sp-state-code').value.trim(),
        active:     true,
        metadata:   { address: document.getElementById('sp-address').value.trim() }
      }})
    })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        savingEl.style.display = 'none';
        document.getElementById('sp-save-btn').disabled = false;
        if (data.errors) { errEl.textContent = data.errors.join(', '); errEl.style.display = 'block'; }
        else { selectSupplier(data); hideSupplierPanel(); }
      })
      .catch(function() {
        savingEl.style.display = 'none';
        document.getElementById('sp-save-btn').disabled = false;
        errEl.textContent = 'Save failed — please try again.';
        errEl.style.display = 'block';
      });
  };

  // ══════════════════════════════════════════════════════════════
  //  METADATA ROWS
  // ══════════════════════════════════════════════════════════════
  window.addMetaRow = function() {
    var ts  = Date.now();
    var div = document.createElement('div');
    div.className = 'meta-row';
    div.style.cssText = 'display:flex;gap:8px;align-items:center';
    div.innerHTML =
      '<input type="text" name="purchase_invoice[metadata][key_' + ts + ']" placeholder="Key" ' +
      'style="width:140px;background:var(--bg);border:1px solid var(--border);border-radius:5px;padding:7px 10px;color:var(--text);font-family:var(--mono);font-size:12px;outline:none">' +
      '<input type="text" name="purchase_invoice[metadata][val_' + ts + ']" placeholder="Value" ' +
      'style="flex:1;background:var(--bg);border:1px solid var(--border);border-radius:5px;padding:7px 10px;color:var(--text);font-size:13px;outline:none">' +
      '<button type="button" onclick="this.closest(\'.meta-row\').remove()" ' +
      'style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:16px;padding:4px">×</button>';
    document.getElementById('meta-rows').appendChild(div);
  };

  // ══════════════════════════════════════════════════════════════
  //  INIT
  // ══════════════════════════════════════════════════════════════
  document.addEventListener('DOMContentLoaded', function() {
    var hint = document.getElementById('supplier-hint-field')?.value || '';
    document.querySelectorAll('#items-tbody tr[data-row]').forEach(function(row) {
      setupProductAutocomplete(row);
      wireRowEvents(row);
      if (hint) applySupplierUiToRow(row, hint);
      // Init review badge for already-persisted matched rows
      var idField = row.querySelector('.product-id-input');
      var inp     = row.querySelector('.product-search-input');
      if (idField && idField.value && inp && inp.value) {
        updateRowMatchBadge(row, true, inp.value);
      }
      validateRow(row);
    });
    updateGrandTotal();
    updateReviewPanel();

    // Reconciliation refreshes when the printed invoice total is edited
    var statedEl = document.getElementById('stated-invoice-total');
    if (statedEl) statedEl.addEventListener('input', function() { updateGrandTotal(); });

    // If editing and supplier hint exists, highlight the correct card
    if (hint) {
      document.querySelectorAll('.supplier-type-card').forEach(function(card) {
        if (card.getAttribute('data-hint') === hint) {
          card.style.borderColor = 'var(--accent)';
          card.style.background  = 'rgba(79,142,247,0.06)';
          var check = card.querySelector('.selected-check');
          if (check) check.style.display = 'flex';
        }
      });
    }

    // Submit guard — warn if any row's total no longer matches its computed value
    var form = document.getElementById('invoice-form');
    if (form) form.addEventListener('submit', function(e) {
      var bad = document.querySelectorAll('#items-tbody tr[data-row][data-invalid="1"]');
      var visibleBad = Array.prototype.filter.call(bad, function(r) { return r.style.display !== 'none'; });
      if (visibleBad.length === 0) return;
      if (!confirm(visibleBad.length + ' line item' + (visibleBad.length > 1 ? 's have' : ' has') +
                   ' a total that does not match qty × rate × GST. Save anyway?')) {
        e.preventDefault();
        visibleBad[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });

})();
</script>

