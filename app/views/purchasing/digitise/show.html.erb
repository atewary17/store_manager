<%# app/views/purchasing/digitise/show.html.erb %>
<% content_for :title, "Scan: #{@import.file_name}" %>
<% content_for :breadcrumb do %>
  <span style="color:var(--text-dim)">Purchasing</span>
  <span class="breadcrumb-sep">/</span>
  <%= link_to 'Digitise', purchasing_digitise_index_path, style: "color:var(--text-dim)" %>
  <span class="breadcrumb-sep">/</span>
  <span class="breadcrumb-current"><%= @import.file_name %></span>
<% end %>

<%# ─────────────────────────────────────────────────────────────────────────
    PROCESSING STATE
────────────────────────────────────────────────────────────────────────── %>
<% if %w[pending processing retrying].include?(@import.status) %>

  <div style="max-width:560px;margin:48px auto">
    <div style="text-align:center;margin-bottom:32px">
      <div id="spinner" style="width:56px;height:56px;border-radius:50%;border:3px solid var(--border);
                  border-top-color:var(--accent);animation:spin 0.9s linear infinite;
                  margin:0 auto 20px"></div>
      <% if @import.status == 'retrying' %>
        <div id="status-label" style="font-size:17px;font-weight:600;color:var(--warning);margin-bottom:6px">
          Rate limited — waiting to retry…
        </div>
        <div style="font-size:12px;color:var(--text-dim);margin-bottom:4px">
          Free tier limit hit. Next attempt in ~60s.
        </div>
      <% else %>
        <div id="status-label" style="font-size:17px;font-weight:600;color:var(--text);margin-bottom:6px">
          AI is reading your invoice…
        </div>
      <% end %>
      <div style="font-size:12px;color:var(--text-dim);margin-bottom:4px">
        <strong style="font-family:var(--mono);color:var(--accent)"><%= @import.file_name %></strong>
      </div>
      <div id="attempt-label" style="font-size:11px;color:var(--text-dim);margin-bottom:8px">
        Attempt <span id="attempt-num"><%= @import.attempt_count.zero? ? 1 : @import.attempt_count %></span> of <%= DigitiseImportJob::MAX_ATTEMPTS %>
      </div>
      <div style="font-size:11px;color:var(--text-dim);margin-bottom:20px">
        Provider: <span style="font-family:var(--mono);color:var(--accent)">
          <%= ENV['INVOICE_AI_PROVIDER']&.upcase || 'GROQ' %>
        </span>
      </div>
      <%= button_to 'Stop', stop_purchasing_digitise_path(@import), method: :post,
            id: 'stop-btn',
            style: 'background:transparent;border:1px solid var(--border);color:var(--text-dim);
                    font-size:12px;padding:6px 18px;border-radius:6px;cursor:pointer' %>
    </div>

    <div id="attempt-log">
      <% if @import.attempt_log.any? %>
        <div style="font-size:11px;font-weight:600;color:var(--text-dim);text-transform:uppercase;
                    letter-spacing:.06em;margin-bottom:8px">Attempt Log</div>
        <% @import.attempt_log.each do |entry| %>
          <div style="border:1px solid var(--border);border-radius:8px;margin-bottom:10px;overflow:hidden">
            <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;
                        background:var(--surface);border-bottom:1px solid var(--border)">
              <span style="font-size:11px;font-family:var(--mono);color:var(--text-dim)">#<%= entry['attempt'] %></span>
              <% if entry['success'] %>
                <span style="font-size:11px;color:var(--success);font-weight:600">✓ Success</span>
              <% else %>
                <span style="font-size:11px;color:var(--danger);font-weight:600">✗ Failed</span>
              <% end %>
              <span style="font-size:11px;color:var(--text-dim);margin-left:auto">
                <%= entry['at'] ? Time.parse(entry['at']).strftime('%H:%M:%S') : '' %>
              </span>
            </div>
            <% if entry['error'].present? %>
              <div style="padding:10px 14px">
                <pre style="margin:0;font-size:11px;font-family:var(--mono);color:var(--danger);
                            white-space:pre-wrap;word-break:break-all"><%= entry['error'] %></pre>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <style>@keyframes spin { to { transform: rotate(360deg); } }</style>
  <script>
    var MAX_POLL = 60;
    var polls    = 0;
    var pollUrl  = '<%= purchasing_digitise_path(@import, format: :json) %>';

    function renderLog(entries) {
      if (!entries || !entries.length) return;
      var html = '';
      entries.forEach(function(e) {
        var sc = e.success ? 'var(--success)' : 'var(--danger)';
        var sl = e.success ? '✓ Success' : '✗ Failed';
        var t  = e.at ? new Date(e.at).toLocaleTimeString() : '';
        html += '<div style="border:1px solid var(--border);border-radius:8px;margin-bottom:10px;overflow:hidden">';
        html += '<div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--surface);border-bottom:1px solid var(--border)">';
        html += '<span style="font-size:11px;font-family:var(--mono);color:var(--text-dim)">#' + e.attempt + '</span>';
        html += '<span style="font-size:11px;color:' + sc + ';font-weight:600">' + sl + '</span>';
        html += '<span style="font-size:11px;color:var(--text-dim);margin-left:auto">' + t + '</span>';
        html += '</div>';
        if (e.error) html += '<div style="padding:10px 14px"><pre style="margin:0;font-size:11px;font-family:var(--mono);color:var(--danger);white-space:pre-wrap;word-break:break-all">' + e.error + '</pre></div>';
        html += '</div>';
      });
      document.getElementById('attempt-log').innerHTML = html;
    }

    (function poll() {
      polls++;
      if (polls > MAX_POLL) {
        document.getElementById('spinner').style.borderTopColor = 'var(--warning)';
        document.getElementById('status-label').textContent = 'Taking longer than expected…';
        document.getElementById('status-label').style.color = 'var(--warning)';
        return;
      }
      setTimeout(function() {
        fetch(pollUrl, { headers: { 'Accept': 'application/json' } })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.attempt) document.getElementById('attempt-num').textContent = data.attempt;
            if (data.attempt_log) renderLog(data.attempt_log);
            if (data.status === 'retrying') {
              var lbl = document.getElementById('status-label');
              if (lbl) { lbl.textContent = 'Rate limited — waiting to retry…'; lbl.style.color = 'var(--warning)'; }
            }
            if (data.terminal) { location.reload(); } else { poll(); }
          })
          .catch(function() { poll(); });
      }, 3000);
    })();
  </script>

<%# ─────────────────────────────────────────────────────────────────────────
    STOPPED STATE
────────────────────────────────────────────────────────────────────────── %>
<% elsif @import.status == 'stopped' %>
  <div style="max-width:560px">
    <div class="flash notice" style="margin-bottom:20px">
      <strong>Processing stopped</strong>
      <div style="margin-top:4px;font-size:12px;color:var(--text-dim)">You stopped the AI extraction.</div>
    </div>
    <div style="display:flex;gap:10px">
      <%= button_to 'Try Again', retry_purchasing_digitise_path(@import), method: :post, class: 'btn btn-primary' %>
      <%= link_to 'Upload different file', new_purchasing_digitise_path, class: 'btn btn-secondary' %>
    </div>
  </div>

<%# ─────────────────────────────────────────────────────────────────────────
    FAILED STATE
────────────────────────────────────────────────────────────────────────── %>
<% elsif @import.status == 'failed' %>
  <div style="max-width:680px">
    <div class="flash alert" style="margin-bottom:20px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
        <strong>AI extraction failed</strong>
        <span style="font-family:var(--mono);font-size:10px;color:var(--text-dim)">
          <%= @import.updated_at.strftime('%d %b %Y, %H:%M') %>
        </span>
      </div>
      <% err = @import.error_message.to_s %>
      <% json_match = err.match(/HTTP \d+:\s*(\{.+)/m) %>
      <% if json_match %>
        <div style="margin-bottom:8px;font-size:12px;color:var(--text)"><%= err.split(':').first(3).join(':') %></div>
        <pre style="background:var(--bg);border:1px solid var(--border);border-radius:6px;
                    padding:12px 14px;font-size:11px;font-family:var(--mono);color:var(--text-dim);
                    overflow-x:auto;white-space:pre-wrap;word-break:break-all;margin:0"><%= begin; JSON.pretty_generate(JSON.parse(json_match[1])); rescue; json_match[1]; end %></pre>
      <% else %>
        <pre style="background:var(--bg);border:1px solid var(--border);border-radius:6px;
                    padding:12px 14px;font-size:11px;font-family:var(--mono);color:var(--text-dim);
                    overflow-x:auto;white-space:pre-wrap;word-break:break-all;margin:0"><%= err %></pre>
      <% end %>
      <% if err.include?('429') %>
        <div style="margin-top:10px;padding:10px 12px;background:rgba(247,195,79,0.08);
                    border:1px solid rgba(247,195,79,0.3);border-radius:6px;font-size:12px;color:var(--warning)">
          <strong>Rate limit hit.</strong> Free tier allows 15 req/min. Wait a minute then click Retry.
        </div>
      <% end %>
    </div>
    <div style="display:flex;gap:10px">
      <%= button_to 'Retry', retry_purchasing_digitise_path(@import), method: :post, class: 'btn btn-primary' %>
      <%= link_to 'Upload different file', new_purchasing_digitise_path, class: 'btn btn-secondary' %>
    </div>
  </div>

<%# ─────────────────────────────────────────────────────────────────────────
    CONFIRMED STATE
────────────────────────────────────────────────────────────────────────── %>
<% elsif @import.status == 'confirmed' %>
  <div style="max-width:520px;text-align:center;padding:48px 0">
    <div style="font-size:32px;margin-bottom:12px">✓</div>
    <div style="font-size:16px;font-weight:600;color:var(--success);margin-bottom:8px">Invoice saved successfully</div>
    <div style="font-size:13px;color:var(--text-dim);margin-bottom:24px">
      This scan was saved as Purchase Invoice
      <strong style="color:var(--text)"><%= @import.purchase_invoice&.display_number %></strong>
    </div>
    <%= link_to 'View Invoice', purchasing_purchase_invoice_path(@import.purchase_invoice_id), class: 'btn btn-primary' %>
    <%= link_to 'Scan Another', new_purchasing_digitise_path, class: 'btn btn-secondary' %>
  </div>

<%# ─────────────────────────────────────────────────────────────────────────
    REVIEW STATE — main content
────────────────────────────────────────────────────────────────────────── %>
<% elsif @import.status == 'review' %>

  <%
    hdr   = @import.parsed_header
    sup   = @import.parsed_supplier
    items = @merged_items   # items from ALL session imports, not just the primary

    # Override item_count, page counts, and grand total with session-level values.
    # For multi-image uploads each DigitiseImport has pages_scanned=1; we aggregate here.
    # Grand total lives on the summary page (last image), not on page 1.
    summary = @import.invoice_summary.merge(
      item_count:    items.size,
      pages_scanned: @session_pages_scanned,
      page_count:    @session_page_count,
      total_amount:  @session_grand_total > 0 ? @session_grand_total : @import.invoice_summary[:total_amount]
    )

    # ── Invoice reconciliation ────────────────────────────────────────────────
    # Mirrors the invoice summary breakdown: Gross → Cash Disc → Taxable → GST → Total
    # "rc_" = computed from line items; "ex_" = extracted from AI-parsed invoice summary
    all_session_hdrs = @session_imports.select { |i| i.status == 'review' }.map(&:parsed_header)

    rc_gross     = items.sum { |i| i['value'].to_f }.round(2)
    rc_cash_disc = items.sum { |i| i['discount_amount'].to_f }.round(2)
    rc_taxable   = items.sum { |i| i['taxable_amount'].to_f }.round(2)
    rc_cgst      = items.sum { |i| i['cgst_amount'].to_f }.round(2)
    rc_sgst      = items.sum { |i| i['sgst_amount'].to_f }.round(2)
    rc_igst      = items.sum { |i| i['igst_amount'].to_f }.round(2)
    rc_gst       = (rc_cgst + rc_sgst + rc_igst).round(2)
    rc_total     = items.sum { |i| i['total_amount'].to_f }.round(2)

    ex_cash_disc = all_session_hdrs.map { |h| h['cash_discount_amount'].to_f }.max.to_f
    ex_taxable   = all_session_hdrs.map { |h| h['total_taxable_amount'].to_f }.max.to_f
    ex_cgst      = all_session_hdrs.map { |h| h['total_cgst'].to_f }.max.to_f
    ex_sgst      = all_session_hdrs.map { |h| h['total_sgst'].to_f }.max.to_f
    ex_igst      = all_session_hdrs.map { |h| h['total_igst'].to_f }.max.to_f
    ex_gst       = (ex_cgst + ex_sgst + ex_igst).round(2)
    ex_total     = all_session_hdrs.map { |h| h['total_amount'].to_f }.max.to_f.round(2)

    # Tolerance: Rs 1.50 covers commercial rounding; > Rs 10 is a real error
    rec_st = ->(computed, extracted) {
      return :na    if extracted <= 0
      d = (computed - extracted).abs
      d <= 1.5 ? :ok : d <= 10.0 ? :warn : :error
    }
    rec_icon  = ->(s) { { ok: '✓', warn: '⚠', error: '✗', na: '—' }[s] || '—' }
    rec_color = ->(s) { { ok: 'var(--success)', warn: 'var(--warning)',
                          error: 'var(--danger)', na: 'var(--text-dim)' }[s] || 'var(--text-dim)' }

    # Auto-detect GST mode from per-line data:
    #   :per_line — items carry non-zero GST %; each line total already includes GST
    #   :summary  — all per-line GST is 0; GST is charged once on the invoice subtotal
    gst_mode = items.any? { |i|
      i['cgst_percent'].to_f + i['sgst_percent'].to_f + i['igst_percent'].to_f > 0
    } ? :per_line : :summary

    # Pack-based suppliers (Shalimar) now use an editable per-line Taxable with the
    # cash discount distributed across lines and GST applied per line — so they are
    # always per-line mode regardless of what the parser put in per-line GST fields.
    gst_mode = :per_line if @supplier_profile&.column_set == :pack_based

    # Summary-mode: derive the GST rate from the invoice header and apply it to rc_total
    # before comparing with ex_total so the reconciliation check is meaningful.
    summary_gst_rate  = (ex_taxable > 0 && ex_gst > 0) ? (ex_gst / ex_taxable * 100).round(2) : 0
    rc_total_with_gst = (gst_mode == :summary && summary_gst_rate > 0) ?
                          (rc_total * (1 + summary_gst_rate / 100.0)).round(2) :
                          rc_total

    rec_cash_disc_st = (rc_cash_disc > 0 || ex_cash_disc > 0) ? rec_st.(rc_cash_disc, ex_cash_disc) : :na
    rec_taxable_st   = rec_st.(rc_taxable, ex_taxable)
    rec_gst_st       = rec_st.(rc_gst, ex_gst)
    rec_total_st     = rec_st.(rc_total_with_gst, ex_total)

    active_sts   = [rec_cash_disc_st, rec_taxable_st, rec_gst_st, rec_total_st].reject { |s| s == :na }
    rec_all_ok   = active_sts.all? { |s| s == :ok }
    rec_has_err  = active_sts.any? { |s| s == :error }
    rec_rounding = ex_total > 0 && rc_total_with_gst > 0 &&
                   (rc_total_with_gst - ex_total).abs.between?(0.01, 2.0)

    computed_grand_total  = rc_total_with_gst
    extracted_grand_total = ex_total
    total_mismatch        = rec_total_st == :error

    # Colour tokens for the intelligence box severity
    sev_bg     = { ok: 'rgba(72,199,142,0.08)', warn: 'rgba(247,195,79,0.08)', error: 'rgba(247,92,83,0.08)' }
    sev_border = { ok: 'rgba(72,199,142,0.3)',  warn: 'rgba(247,195,79,0.3)',  error: 'rgba(247,92,83,0.3)' }
    sev_colour = { ok: 'var(--success)',         warn: 'var(--warning)',        error: 'var(--danger)' }
    sev_icon   = { ok: '✓',                      warn: '⚠',                    error: '✗' }
    severity   = summary[:severity]

    append_mode      = @existing_invoice.present?
    session_size     = @session_imports.size
    session_pending  = @session_pending.size
    session_ready    = session_size - session_pending
  %>

  <style>
    /* Full-width layout override */
    .main-content { max-width: 100% !important; }
    .form-card    { max-width: 100% !important; }
    .page-content { padding: 20px 24px !important; }

    /* Hide number-input spinner arrows so narrow numeric cells show full digits */
    .no-spin::-webkit-outer-spin-button,
    .no-spin::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .no-spin { -moz-appearance: textfield; appearance: textfield; }

    /* The items table uses border-collapse:separate so the Status column can be
       position:sticky. In separate mode <tr> borders are ignored, so row dividers
       must live on the cells. */
    .items-grid td { border-bottom: 1px solid var(--border); }

    /* Two-column review layout */
    .review-layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 16px;
      align-items: start;
      overflow: hidden;
    }

    /* Preview panel */
    .preview-panel {
      position: sticky;
      top: 20px;
      max-height: calc(100vh - 80px);
      overflow-y: auto;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }
    .preview-panel-header {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      font-size: 11px;
      font-weight: 600;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: .07em;
      background: var(--bg);
      position: sticky;
      top: 0;
      z-index: 1;
    }
    .preview-panel-body {
      overflow-y: auto;
      max-height: calc(100vh - 160px);
    }

    /* Intelligence box */
    .intel-box {
      border-radius: 10px;
      padding: 16px 18px;
      margin-bottom: 18px;
    }
    .intel-box-row {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }
    .intel-stat { text-align: center; min-width: 60px; }
    .intel-stat-val { font-size: 22px; font-weight: 700; font-family: var(--mono); }
    .intel-stat-lbl { font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: .06em; margin-top: 2px; }

    /* Page bar */
    .page-bar { display: flex; gap: 4px; align-items: center; margin: 8px 0; }
    .page-dot {
      width: 16px; height: 8px; border-radius: 4px;
      background: var(--border);
      transition: background 0.2s;
    }
    .page-dot.scanned { background: var(--success); }
    .page-dot.missing { background: var(--danger); }
    .page-dot.warn    { background: var(--warning); }

    /* Locked item rows */
    .item-row-locked { background: rgba(255,255,255,0.015); opacity: 0.7; }
    .item-row-new    { background: rgba(79,142,247,0.04); }

    /* Preview panel — clickable */
    .preview-panel { cursor: zoom-in; }
    .preview-panel:hover .preview-zoom-hint { opacity: 1 !important; }

    /* Lightbox overlay */
    #lb-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0,0,0,0.93);
      align-items: flex-start;
      justify-content: center;
      overflow-y: auto;
      padding: 40px 20px;
    }
    #lb-overlay.open { display: flex; }
    #lb-close {
      position: fixed;
      top: 16px;
      right: 20px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      color: #fff;
      font-size: 18px;
      line-height: 1;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10000;
    }
    #lb-close:hover { background: rgba(255,255,255,0.22); }
    .lb-img-wrap { text-align: center; margin-bottom: 24px; }
    .lb-img-wrap img { max-width: min(860px, 90vw); border-radius: 8px; display: block; margin: 0 auto; }
    .lb-label { color: rgba(255,255,255,0.45); font-size: 11px; margin-bottom: 10px; font-family: var(--mono); }
    .lb-counter { color: rgba(255,255,255,0.3); font-size: 11px; margin-top: 6px; }
  </style>

  <%= form_with url: confirm_purchasing_digitise_path(@import), method: :post,
        local: true, id: 'confirm-form' do |f| %>

    <%# ── TOP BANNER ── %>
    <div style="display:flex;align-items:center;gap:16px;background:rgba(79,142,247,0.07);
                border:1px solid rgba(79,142,247,0.25);border-radius:10px;padding:14px 20px;
                margin-bottom:20px">
      <div style="font-size:26px;flex-shrink:0">🤖</div>
      <div style="flex:1">
        <div style="font-size:14px;font-weight:700;color:var(--accent);margin-bottom:2px">
          Review AI-extracted data before saving
        </div>
        <div style="font-size:12px;color:var(--text-dim)">
          Check every field — especially material codes, quantities and totals.
          <% if append_mode %>
            <strong style="color:var(--warning)">Append mode:</strong>
            confirmed items (grey rows) are locked; new items are highlighted in blue.
          <% end %>
        </div>
      </div>
      <div style="margin-left:auto;display:flex;gap:10px;flex-shrink:0;align-items:center">
        <%= link_to '← Back', purchasing_digitise_index_path, class: 'btn btn-secondary' %>
        <button type="submit" class="btn btn-primary" id="save-btn">
          <%= append_mode ? 'Append Items →' : 'Save as Draft →' %>
        </button>
      </div>
    </div>

    <%# ── SESSION PENDING BANNER — shown when sibling images are still processing ── %>
    <% if session_pending > 0 %>
      <div id="session-pending-banner"
           style="display:flex;align-items:center;gap:14px;background:rgba(247,195,79,0.08);
                  border:1px solid rgba(247,195,79,0.3);border-radius:10px;
                  padding:12px 18px;margin-bottom:16px">
        <div style="width:16px;height:16px;border-radius:50%;border:2px solid var(--warning);
                    border-top-color:transparent;animation:spin 0.8s linear infinite;flex-shrink:0"></div>
        <div style="flex:1">
          <div style="font-size:13px;font-weight:600;color:var(--warning)">
            Processing <%= session_pending %> more
            <%= session_pending == 1 ? 'image' : 'images' %>…
          </div>
          <div style="font-size:11px;color:var(--text-dim);margin-top:2px">
            <%= session_ready %> of <%= session_size %> files ready.
            Showing items from completed pages only — this page will update automatically.
          </div>
        </div>
        <div style="font-size:11px;font-family:var(--mono);color:var(--text-dim);flex-shrink:0">
          <%= session_ready %>/<%= session_size %> done
        </div>
      </div>
      <%# Auto-refresh every 3 s until all siblings are processed %>
      <script>setTimeout(function(){ location.reload(); }, 3000);</script>
    <% end %>

    <div class="review-layout">

      <%# ═══════════════════════════════════════════════════════════
          LEFT: PREVIEW PANEL
      ═══════════════════════════════════════════════════════════ %>
      <div class="preview-panel" onclick="lbOpen()" title="Click to enlarge">
        <div class="preview-panel-header">
          Uploaded Invoice
          <span style="color:var(--accent);font-weight:400;text-transform:none;letter-spacing:0;
                       font-size:10px;margin-left:6px"><%= @import.file_name %></span>
        </div>
        <div class="preview-panel-body" style="padding:12px;position:relative">

          <% if @import.preview_image.present? %>
            <img src="data:image/jpeg;base64,<%= @import.preview_image %>"
                 alt="Invoice page 1 preview"
                 style="width:100%;border-radius:6px;border:1px solid var(--border);
                        display:block;margin-bottom:8px">
            <% if @import.ai_page_count > 1 %>
              <div style="font-size:10px;color:var(--text-dim);text-align:center;margin-bottom:4px">
                Page 1 of <%= @import.ai_page_count %> shown
              </div>
            <% end %>

          <% elsif @import.image? %>
            <% safe_mime = @import.file_content_type.in?(%w[image/jpeg image/jpg image/png image/webp]) ? @import.file_content_type : 'image/jpeg' %>
            <img src="data:<%= safe_mime %>;base64,<%= @import.file_data %>"
                 alt="Invoice preview"
                 style="width:100%;border-radius:6px;border:1px solid var(--border);display:block">

          <% else %>
            <div style="text-align:center;padding:30px 0;color:var(--text-dim);font-size:12px">
              <div style="font-size:28px;margin-bottom:8px">📄</div>
              Preview not available
            </div>
          <% end %>

          <%# Zoom hint overlay %>
          <div class="preview-zoom-hint"
               style="position:absolute;bottom:56px;left:0;right:0;text-align:center;
                      opacity:0;transition:opacity 0.2s;pointer-events:none">
            <span style="background:rgba(0,0,0,0.65);color:#fff;font-size:11px;
                         border-radius:20px;padding:4px 12px">
              🔍 Click to enlarge
              <% if session_size > 1 %>· <%= session_size %> pages<% end %>
            </span>
          </div>

          <%# File meta %>
          <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--border)">
            <div style="font-size:10px;color:var(--text-dim);margin-bottom:3px">
              <strong style="color:var(--text)">Type:</strong> <%= @import.file_content_type %>
            </div>
            <% if session_size > 1 %>
              <div style="font-size:10px;color:var(--text-dim);margin-bottom:3px">
                <strong style="color:var(--text)">Files:</strong>
                <%= session_size %> images
                <% if session_pending > 0 %>
                  <span style="color:var(--warning)">(<%= session_pending %> processing)</span>
                <% end %>
              </div>
            <% end %>
            <div style="font-size:10px;color:var(--text-dim);margin-bottom:3px">
              <strong style="color:var(--text)">Size:</strong> <%= @import.file_size_human %>
            </div>
            <div style="font-size:10px;color:var(--text-dim)">
              <strong style="color:var(--text)">Scanned:</strong>
              <%= @import.created_at.strftime('%d %b %Y, %H:%M') %>
            </div>
          </div>
        </div>
      </div>

      <%# ═══════════════════════════════════════════════════════════
          RIGHT: FORM + INTELLIGENCE BOX + ITEMS
      ═══════════════════════════════════════════════════════════ %>
      <div style="min-width:0;overflow:hidden">

        <%# ── SUPPLIER CARD ── %>
        <div class="form-card" style="margin-bottom:14px">
          <div class="form-section">
            <div class="form-section-title">Supplier</div>
            <div class="form-row" style="grid-template-columns:2fr 1fr 1fr;gap:14px">
              <div class="form-group" style="margin-bottom:0">
                <label>Supplier Name</label>
                <input type="text" name="parsed_data[supplier][name]"
                       value="<%= sup['name'] %>" class="form-control">
              </div>
              <div class="form-group" style="margin-bottom:0">
                <label>GSTIN</label>
                <input type="text" name="parsed_data[supplier][gstin]"
                       value="<%= sup['gstin'] %>"
                       class="form-control" style="font-family:var(--mono)">
              </div>
              <div class="form-group" style="margin-bottom:0">
                <label>State</label>
                <input type="text" name="parsed_data[supplier][state]"
                       value="<%= sup['state'] %>" class="form-control">
              </div>
            </div>
          </div>
        </div>

        <%# ── INVOICE HEADER CARD ── %>
        <div class="form-card" style="margin-bottom:14px">
          <div class="form-section">
            <div class="form-section-title">Invoice Details</div>
            <%# Row 1: invoice number + date %>
            <div class="form-row" style="grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
              <div class="form-group" style="margin-bottom:0">
                <label>Invoice Number</label>
                <input type="text" name="parsed_data[header][invoice_number]"
                       value="<%= hdr['invoice_number'] %>"
                       class="form-control" style="font-family:var(--mono)">
              </div>
              <div class="form-group" style="margin-bottom:0">
                <label>Invoice Date</label>
                <input type="date" name="parsed_data[header][invoice_date]"
                       value="<%= hdr['invoice_date'] %>" class="form-control">
              </div>
            </div>
            <%# Row 2: delivery date + payment due %>
            <div class="form-row" style="grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
              <div class="form-group" style="margin-bottom:0">
                <label>Delivery Date</label>
                <input type="date" name="parsed_data[header][delivery_date]"
                       value="<%= hdr['delivery_date'] %>" class="form-control">
              </div>
              <div class="form-group" style="margin-bottom:0">
                <label style="color:var(--accent)">Payment Due Date</label>
                <input type="date" name="payment_due_date" class="form-control"
                       style="border-color:rgba(79,142,247,0.5)">
                <div class="form-hint">For credit purchases</div>
              </div>
            </div>
            <%# Row 3: delivery/LR + place of supply + grand total %>
            <div class="form-row" style="grid-template-columns:1fr 1fr 1fr;gap:14px">
              <div class="form-group" style="margin-bottom:0">
                <label>Delivery / LR No.</label>
                <input type="text" name="parsed_data[header][delivery_number]"
                       value="<%= hdr['delivery_number'].presence || hdr['lr_number'] %>"
                       class="form-control" style="font-family:var(--mono)">
              </div>
              <div class="form-group" style="margin-bottom:0">
                <label>Place of Supply</label>
                <input type="text" name="parsed_data[header][place_of_supply]"
                       value="<%= hdr['place_of_supply'] %>" class="form-control">
              </div>
              <div class="form-group" style="margin-bottom:0">
                <label>Grand Total (Rs.)</label>
                <input type="number" name="parsed_data[header][total_amount]"
                       value="<%= computed_grand_total > 0 ? computed_grand_total : (summary[:total_amount] > 0 ? summary[:total_amount] : hdr['total_amount']) %>"
                       class="form-control"
                       style="font-family:var(--mono);font-weight:600;color:var(--accent)" step="0.01">
              </div>
            </div>
          </div>
        </div>

        <%# ── INVOICE INTELLIGENCE BOX ── %>
        <div class="intel-box"
             style="background:<%= sev_bg[severity] %>;border:1px solid <%= sev_border[severity] %>">

          <%# Header row: invoice identity %>
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px">
            <div>
              <div style="font-size:13px;font-weight:700;color:var(--text)">
                Invoice <%= summary[:invoice_number] %>
              </div>
              <div style="font-size:11px;color:var(--text-dim);margin-top:2px">
                <%= summary[:supplier_name] %>
                <% if summary[:invoice_date] != '—' %>
                  &nbsp;·&nbsp; <%= summary[:invoice_date] %>
                <% end %>
              </div>
            </div>
            <% if append_mode %>
              <div style="background:rgba(247,195,79,0.15);border:1px solid rgba(247,195,79,0.4);
                          border-radius:6px;padding:4px 10px;font-size:11px;
                          color:var(--warning);font-weight:600;white-space:nowrap">
                Append mode — existing draft found
              </div>
            <% end %>
          </div>

          <%# Stats row %>
          <div class="intel-box-row">
            <div class="intel-stat">
              <div class="intel-stat-val" style="color:var(--accent)"><%= summary[:item_count] %></div>
              <div class="intel-stat-lbl">Items found</div>
            </div>
            <% if summary[:page_count] > 0 %>
              <div class="intel-stat">
                <div class="intel-stat-val" style="color:var(--text)"><%= summary[:pages_scanned] %></div>
                <div class="intel-stat-lbl">Pages scanned</div>
              </div>
              <div class="intel-stat">
                <div class="intel-stat-val" style="color:<%= summary[:pages_missing] > 0 ? 'var(--warning)' : 'var(--success)' %>">
                  <%= summary[:page_count] %>
                </div>
                <div class="intel-stat-lbl">Total pages</div>
              </div>
            <% end %>
            <% if summary[:total_amount] > 0 %>
              <div class="intel-stat" style="margin-left:auto;text-align:right">
                <div class="intel-stat-val" style="color:var(--accent);font-size:16px">
                  Rs. <%= number_with_precision(summary[:total_amount], precision: 2, delimiter: ',') %>
                </div>
                <div class="intel-stat-lbl">Grand total</div>
              </div>
            <% end %>
          </div>

          <%# Visual page progress bar %>
          <% if summary[:page_count] > 1 %>
            <div style="margin-bottom:10px">
              <div style="font-size:10px;color:var(--text-dim);margin-bottom:5px;
                          text-transform:uppercase;letter-spacing:.06em">Page Coverage</div>
              <div class="page-bar">
                <% summary[:page_count].times do |i| %>
                  <% page_num = i + 1 %>
                  <% is_last  = page_num == summary[:page_count] %>
                  <% scanned  = page_num <= summary[:pages_scanned] %>
                  <%
                    dot_class = if scanned
                                  'scanned'
                                elsif is_last && @import.only_last_pages_missing?
                                  'warn'
                                else
                                  'missing'
                                end
                  %>
                  <div class="page-dot <%= dot_class %>"
                       title="Page <%= page_num %>: <%= scanned ? 'Scanned' : 'Not uploaded' %>"></div>
                <% end %>
                <span style="font-size:10px;color:var(--text-dim);margin-left:6px">
                  <%= summary[:pages_scanned] %> of <%= summary[:page_count] %>
                </span>
              </div>
              <div style="display:flex;gap:12px;font-size:10px;color:var(--text-dim)">
                <span><span style="display:inline-block;width:10px;height:5px;border-radius:2px;background:var(--success);margin-right:3px"></span>Scanned</span>
                <span><span style="display:inline-block;width:10px;height:5px;border-radius:2px;background:var(--warning);margin-right:3px"></span>Likely blank</span>
                <span><span style="display:inline-block;width:10px;height:5px;border-radius:2px;background:var(--danger);margin-right:3px"></span>Missing</span>
              </div>
            </div>
          <% end %>

          <%# Status message %>
          <% if summary[:page_status].present? %>
            <div style="background:rgba(0,0,0,0.15);border-radius:6px;padding:10px 12px;
                        font-size:12px;color:var(--text);line-height:1.6;margin-bottom:10px">
              <span style="font-size:14px;margin-right:6px"><%= sev_icon[severity] %></span>
              <%= summary[:page_status] %>
            </div>
          <% end %>

          <%# Duplicate items warning %>
          <% if @duplicates.present? %>
            <div style="background:rgba(247,92,83,0.1);border:1px solid rgba(247,92,83,0.3);
                        border-radius:6px;padding:10px 12px;font-size:12px;margin-bottom:10px">
              <strong style="color:var(--danger)">Duplicate items detected</strong>
              <div style="color:var(--text-dim);margin-top:4px">
                The following items already exist in invoice <%= @existing_invoice.display_number %>
                and will be skipped:
                <ul style="margin:6px 0 0 16px;padding:0">
                  <% @duplicates.each do |d| %>
                    <li style="color:var(--text)">
                      <%= d['description'].presence || d['material_code'] %>
                      <span style="color:var(--text-dim)">(qty: <%= d['quantity'] %>)</span>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>

          <%# Invoice reconciliation %>
          <% if rc_total > 0 || ex_total > 0 %>
            <div style="background:rgba(0,0,0,0.15);border-radius:6px;padding:10px 12px;margin-bottom:10px">

              <%# Header row with overall status %>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                <span style="font-size:10px;font-weight:700;color:var(--text-dim);
                             text-transform:uppercase;letter-spacing:.07em">Invoice Reconciliation</span>
                <span id="rec-banner" style="font-size:11px;font-weight:700;
                             color:<%= rec_has_err ? 'var(--danger)' : rec_all_ok ? 'var(--success)' : 'var(--warning)' %>">
                  <%= rec_has_err ? '✗ Issues found — check highlighted items' :
                      rec_all_ok  ? '✓ All checks passed' :
                                    '⚠ Minor differences' %>
                </span>
              </div>

              <%# Column headers %>
              <div style="display:grid;grid-template-columns:1fr 100px 100px 24px;
                          gap:0;font-size:10px;color:var(--text-dim);
                          border-bottom:1px solid rgba(255,255,255,0.08);padding-bottom:4px;margin-bottom:2px">
                <span>Component</span>
                <span style="text-align:right;font-family:var(--mono)">From Items</span>
                <span style="text-align:right;font-family:var(--mono)">From Invoice</span>
                <span></span>
              </div>

              <%# Gross Value row — only if AI returned value per line %>
              <% if rc_gross > 0 %>
                <div style="display:grid;grid-template-columns:1fr 100px 100px 24px;
                            gap:0;font-size:11px;padding:3px 0;color:var(--text)">
                  <span>Gross Value</span>
                  <span style="text-align:right;font-family:var(--mono)">
                    <%= number_with_precision(rc_gross, precision: 2, delimiter: ',') %>
                  </span>
                  <span style="text-align:right;font-family:var(--mono);color:var(--text-dim)">—</span>
                  <span></span>
                </div>
              <% end %>

              <%# Cash Discount row %>
              <% if rc_cash_disc > 0 || ex_cash_disc > 0 %>
                <div style="display:grid;grid-template-columns:1fr 100px 100px 24px;
                            gap:0;font-size:11px;padding:3px 0;color:var(--text-dim)">
                  <span>− Cash Discount</span>
                  <span id="rec-cash-disc" style="text-align:right;font-family:var(--mono);color:var(--warning)">
                    <%= rc_cash_disc > 0 ? number_with_precision(rc_cash_disc, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span style="text-align:right;font-family:var(--mono)">
                    <%= ex_cash_disc > 0 ? number_with_precision(ex_cash_disc, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span id="rec-cash-disc-status" style="text-align:center;font-weight:700;color:<%= rec_color.(rec_cash_disc_st) %>">
                    <%= rec_icon.(rec_cash_disc_st) %>
                  </span>
                </div>
              <% end %>

              <%# Taxable Amount row %>
              <% if rc_taxable > 0 || ex_taxable > 0 %>
                <div style="display:grid;grid-template-columns:1fr 100px 100px 24px;
                            gap:0;font-size:11px;padding:3px 0;font-weight:600;color:var(--text);
                            border-top:1px solid rgba(255,255,255,0.06)">
                  <span>= Taxable Amount</span>
                  <span id="rec-taxable" style="text-align:right;font-family:var(--mono)">
                    <%= number_with_precision(rc_taxable, precision: 2, delimiter: ',') %>
                  </span>
                  <span style="text-align:right;font-family:var(--mono);font-weight:400;color:var(--text-dim)">
                    <%= ex_taxable > 0 ? number_with_precision(ex_taxable, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span id="rec-taxable-status" style="text-align:center;font-weight:700;color:<%= rec_color.(rec_taxable_st) %>">
                    <%= rec_icon.(rec_taxable_st) %>
                  </span>
                </div>
              <% end %>

              <%# CGST row %>
              <% if rc_cgst > 0 || ex_cgst > 0 %>
                <div style="display:grid;grid-template-columns:1fr 100px 100px 24px;
                            gap:0;font-size:11px;padding:3px 0;color:var(--text-dim)">
                  <span>+ CGST<% if ex_cgst > 0 && ex_taxable > 0 %>
                    <span style="font-family:var(--mono);font-size:10px">
                      (<%= (ex_cgst / ex_taxable * 100).round(1) %>%)
                    </span><% end %></span>
                  <span id="rec-cgst" style="text-align:right;font-family:var(--mono)">
                    <%= rc_cgst > 0 ? number_with_precision(rc_cgst, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span style="text-align:right;font-family:var(--mono)">
                    <%= ex_cgst > 0 ? number_with_precision(ex_cgst, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span></span>
                </div>
              <% end %>

              <%# SGST row %>
              <% if rc_sgst > 0 || ex_sgst > 0 %>
                <div style="display:grid;grid-template-columns:1fr 100px 100px 24px;
                            gap:0;font-size:11px;padding:3px 0;color:var(--text-dim)">
                  <span>+ SGST<% if ex_sgst > 0 && ex_taxable > 0 %>
                    <span style="font-family:var(--mono);font-size:10px">
                      (<%= (ex_sgst / ex_taxable * 100).round(1) %>%)
                    </span><% end %></span>
                  <span id="rec-sgst" style="text-align:right;font-family:var(--mono)">
                    <%= rc_sgst > 0 ? number_with_precision(rc_sgst, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span style="text-align:right;font-family:var(--mono)">
                    <%= ex_sgst > 0 ? number_with_precision(ex_sgst, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span></span>
                </div>
              <% end %>

              <%# IGST row (inter-state) %>
              <% if rc_igst > 0 || ex_igst > 0 %>
                <div style="display:grid;grid-template-columns:1fr 100px 100px 24px;
                            gap:0;font-size:11px;padding:3px 0;color:var(--text-dim)">
                  <span>+ IGST<% if ex_igst > 0 && ex_taxable > 0 %>
                    <span style="font-family:var(--mono);font-size:10px">
                      (<%= (ex_igst / ex_taxable * 100).round(1) %>%)
                    </span><% end %></span>
                  <span id="rec-igst" style="text-align:right;font-family:var(--mono)">
                    <%= rc_igst > 0 ? number_with_precision(rc_igst, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span style="text-align:right;font-family:var(--mono)">
                    <%= ex_igst > 0 ? number_with_precision(ex_igst, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span></span>
                </div>
              <% end %>

              <%# GST sub-total row (only if we have both CGST and SGST) %>
              <% if (rc_cgst > 0 || rc_sgst > 0) && rc_gst > 0 %>
                <div style="display:grid;grid-template-columns:1fr 100px 100px 24px;
                            gap:0;font-size:11px;padding:3px 0;color:var(--text);font-weight:600;
                            border-top:1px dashed rgba(255,255,255,0.06)">
                  <span>+ GST Total</span>
                  <span id="rec-gst-total" style="text-align:right;font-family:var(--mono)">
                    <%= number_with_precision(rc_gst, precision: 2, delimiter: ',') %>
                  </span>
                  <span style="text-align:right;font-family:var(--mono);font-weight:400;color:var(--text-dim)">
                    <%= ex_gst > 0 ? number_with_precision(ex_gst, precision: 2, delimiter: ',') : '—' %>
                  </span>
                  <span id="rec-gst-status" style="text-align:center;font-weight:700;color:<%= rec_color.(rec_gst_st) %>">
                    <%= rec_icon.(rec_gst_st) %>
                  </span>
                </div>
              <% end %>

              <%# Grand Total row %>
              <div style="display:grid;grid-template-columns:1fr 100px 100px 24px;
                          gap:0;font-size:12px;padding:5px 0;font-weight:700;color:var(--accent);
                          border-top:2px solid rgba(255,255,255,0.1);margin-top:2px">
                <span style="color:var(--text)">= Grand Total
                  <% if gst_mode == :summary && summary_gst_rate > 0 %>
                    <span style="font-size:9px;font-weight:400;color:var(--text-dim);
                                 background:rgba(255,255,255,0.06);border-radius:4px;
                                 padding:1px 5px;margin-left:4px;vertical-align:middle">
                      GST: Summary (<%= summary_gst_rate.to_i %>%)
                    </span>
                  <% elsif gst_mode == :per_line %>
                    <span style="font-size:9px;font-weight:400;color:var(--text-dim);
                                 background:rgba(255,255,255,0.06);border-radius:4px;
                                 padding:1px 5px;margin-left:4px;vertical-align:middle">
                      GST: Per line
                    </span>
                  <% end %>
                </span>
                <span id="rec-computed-total"
                      data-gst-mode="<%= gst_mode %>"
                      data-summary-gst-rate="<%= summary_gst_rate %>"
                      data-gst-split="<%= (rc_igst > 0 || ex_igst > 0) ? 'inter' : 'intra' %>"
                      data-ex-cash-disc="<%= ex_cash_disc %>"
                      data-ex-taxable="<%= ex_taxable %>"
                      data-ex-gst="<%= ex_gst %>"
                      data-ex-total="<%= ex_total %>"
                      style="text-align:right;font-family:var(--mono)">
                  <%= number_with_precision(rc_total_with_gst, precision: 2, delimiter: ',') %>
                  <% if gst_mode == :summary && summary_gst_rate > 0 %>
                    <div style="font-size:9px;font-weight:400;color:var(--text-dim)">
                      (+ <%= summary_gst_rate.to_i %>% GST)
                    </div>
                  <% end %>
                </span>
                <span id="rec-ai-total" data-value="<%= ex_total %>"
                      style="text-align:right;font-family:var(--mono);font-weight:400;color:var(--text-dim)">
                  <%= ex_total > 0 ? number_with_precision(ex_total, precision: 2, delimiter: ',') : '—' %>
                </span>
                <span id="rec-total-status" style="text-align:center;font-size:13px;color:<%= rec_color.(rec_total_st) %>">
                  <%= rec_icon.(rec_total_st) %>
                </span>
              </div>

              <%# Footnote: commercial rounding or error explanation.
                  Always rendered (id=rec-footnote) so updateReconciliation() can
                  refresh/hide it live after client-side edits. %>
              <%
                fn_initial =
                  if rec_rounding && rec_total_st != :error
                    { text: "Difference Rs. #{number_with_precision((rc_total_with_gst - ex_total).abs, precision: 2)} — commercial rounding applied by supplier",
                      color: 'var(--text-dim)', show: true }
                  elsif total_mismatch
                    { text: "Diff Rs. #{number_with_precision((rc_total_with_gst - ex_total).abs, precision: 2, delimiter: ',')} — pages may be missing or AI misread a column. Check quantities carefully.",
                      color: 'var(--danger)', show: true }
                  else
                    { text: '', color: 'var(--text-dim)', show: false }
                  end
              %>
              <div id="rec-footnote"
                   style="font-size:10px;margin-top:4px;color:<%= fn_initial[:color] %>;
                          <%= fn_initial[:show] ? '' : 'display:none' %>">
                <%= fn_initial[:text] %>
              </div>

            </div>
          <% end %>

          <%# Action row for missing pages %>
          <% if @import.pages_missing? %>
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
              <%= link_to 'Upload missing pages', new_purchasing_digitise_path,
                    style: 'font-size:12px;font-weight:600;color:var(--accent);text-decoration:none;
                            background:rgba(79,142,247,0.1);border:1px solid rgba(79,142,247,0.3);
                            border-radius:6px;padding:5px 12px' %>
              <span style="font-size:11px;color:var(--text-dim)">
                — or confirm below to proceed with <%= summary[:item_count] %> items as-is
              </span>
            </div>
          <% end %>
        </div>

      </div><%# end right column %>
    </div><%# end review-layout %>

    <%# ── LINE ITEMS CARD — full width, outside grid ── %>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;
                margin-bottom:18px;overflow:hidden">
      <div style="padding:13px 18px;border-bottom:1px solid var(--border);
                  display:flex;align-items:center;justify-content:space-between">
        <span style="font-family:var(--mono);font-size:11px;letter-spacing:.1em;
                     text-transform:uppercase;color:var(--text-dim)">
          Line Items
          <span style="color:var(--accent);margin-left:6px">(<%= items.size %>)</span>
          <% if append_mode && @confirmed_items.any? %>
            <span style="color:var(--text-dim);margin-left:10px">+</span>
            <span style="color:var(--text-dim);margin-left:4px">
              <%= @confirmed_items.size %> confirmed (locked)
            </span>
          <% end %>
        </span>
        <span style="font-size:11px;color:var(--text-dim)">
          ⚠ <span style="color:var(--warning);font-weight:600">UNMATCHED</span>
          items need product linking after saving
        </span>
      </div>

      <div style="overflow-x:auto;width:100%">
        <table class="items-grid" style="width:100%;border-collapse:separate;border-spacing:0;font-size:12px;table-layout:auto">
          <thead>
            <tr style="background:var(--bg)">
              <% pack_based = @supplier_profile&.column_set == :pack_based %>
              <% generic    = @supplier_profile&.column_set == :generic %>
              <% col_count  = generic ? 11 : 12 %>
              <% [
                ['#',                                              '28px',  'center'],
                (generic ? nil : [pack_based ? 'Product Code' : 'Material Code', '90px', 'left']),
                ['Description',                                    'auto',  'left'],
                ['HSN',                                            '58px',  'center'],
                [pack_based ? 'Packs'     : 'Qty',                 '58px',  'right'],
                ['UOM',                                            '46px',  'center'],
                [pack_based ? 'Rate/Pack' : 'Rate/Unit',           '72px',  'right'],
                [generic ? 'Disc %' : 'Disc Rs.',                  '62px',  'right'],
                ['Taxable',                                        '72px',  'right'],
                ['GST%',                                           '46px',  'center'],
                ['Total (Rs.)',                                    '82px',  'right'],
                ['Status',                                         '56px',  'center'],
              ].compact.each do |lbl, w, align| %>
                <% sticky = (lbl == 'Status') ? 'position:sticky;right:0;background:var(--bg);z-index:2;' : '' %>
                <th style="min-width:<%= w %>;padding:7px 6px;text-align:<%= align %>;
                           font-family:var(--mono);font-size:10px;letter-spacing:.07em;
                           text-transform:uppercase;color:var(--text-dim);
                           border-bottom:1px solid var(--border);white-space:nowrap;<%= sticky %>"><%= lbl %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>

                <%# ── CONFIRMED (LOCKED) ROWS — append mode only ── %>
                <% if append_mode && @confirmed_items.any? %>
                  <tr>
                    <td colspan="<%= col_count %>"
                        style="padding:6px 12px;font-size:10px;font-weight:700;color:var(--text-dim);
                               text-transform:uppercase;letter-spacing:.07em;
                               background:rgba(255,255,255,0.02);border-bottom:1px solid var(--border)">
                      Previously confirmed items (read-only)
                    </td>
                  </tr>
                  <% @confirmed_items.each_with_index do |item, idx| %>
                    <tr class="item-row-locked">
                      <td style="padding:8px;text-align:center;font-family:var(--mono);color:var(--text-dim);font-size:11px"><%= idx + 1 %></td>
                      <% unless generic %>
                        <td style="padding:8px;font-family:var(--mono);font-size:11px;color:var(--text-dim)">
                          <%= item.metadata['material_code'].presence || '—' %>
                        </td>
                      <% end %>
                      <td style="padding:8px;font-size:12px;color:var(--text-dim)">
                        <%= item.metadata['description'].presence || item.product&.name || '—' %>
                        <% if item.metadata['pack_size'].present? %>
                          <div style="font-size:10px;color:var(--text-dim);font-family:var(--mono)">
                            <%= item.metadata['pack_size'] %> × <%= item.metadata['num_packs'] %>
                          </div>
                        <% end %>
                      </td>
                      <td style="padding:8px;text-align:center;font-family:var(--mono);font-size:11px;color:var(--text-dim)">
                        <%= item.metadata['hsn_code'].presence || '—' %>
                      </td>
                      <td style="padding:8px;text-align:right;font-family:var(--mono);font-size:11px;color:var(--text-dim)">
                        <%= number_with_precision(item.quantity, precision: 3) %>
                      </td>
                      <td style="padding:8px;text-align:center;font-family:var(--mono);font-size:11px;color:var(--text-dim)">
                        <%= item.metadata['unit'].presence || item.product&.base_uom&.name || '—' %>
                      </td>
                      <td style="padding:8px;text-align:right;font-family:var(--mono);font-size:11px;color:var(--text-dim)">
                        <%= number_with_precision(item.unit_rate, precision: 2, delimiter: ',') %>
                      </td>
                      <td style="padding:8px;text-align:right;font-family:var(--mono);font-size:11px;color:var(--text-dim)">
                        <%= item.metadata['discount_amount'].to_f > 0 ? number_with_precision(item.metadata['discount_amount'], precision: 2) : '—' %>
                      </td>
                      <td style="padding:8px;text-align:right;font-family:var(--mono);font-size:11px;color:var(--text-dim)">
                        <%= item.taxable_amount.to_f > 0 ? number_with_precision(item.taxable_amount, precision: 2, delimiter: ',') : '—' %>
                      </td>
                      <td style="padding:8px;text-align:center;font-family:var(--mono);font-size:11px;color:var(--text-dim)">
                        <% gst = item.metadata['cgst_percent'].to_f + item.metadata['sgst_percent'].to_f + item.metadata['igst_percent'].to_f %>
                        <%= gst > 0 ? "#{gst.to_i}%" : '—' %>
                      </td>
                      <td style="padding:8px;text-align:right;font-family:var(--mono);font-size:11px;color:var(--text-dim);font-weight:600">
                        Rs. <%= number_with_precision(item.total_amount, precision: 2, delimiter: ',') %>
                      </td>
                      <td style="padding:8px;text-align:center">
                        <span style="font-size:10px;color:var(--success);font-family:var(--mono);font-weight:700">CONFIRMED</span>
                      </td>
                    </tr>
                  <% end %>

                  <% if items.any? %>
                    <tr>
                      <td colspan="<%= col_count %>"
                          style="padding:6px 12px;font-size:10px;font-weight:700;color:var(--accent);
                                 text-transform:uppercase;letter-spacing:.07em;
                                 background:rgba(79,142,247,0.05);border-bottom:1px solid var(--border)">
                        New items from this upload — review before saving
                      </td>
                    </tr>
                  <% end %>
                <% end %>

                <%# ── NEW / EDITABLE ITEM ROWS ── %>
                <%
                  # Build a map of flat-index → page number so we can inject
                  # "Page N" separator rows without duplicating row-rendering logic.
                  page_boundaries = {}
                  if @item_pages&.size.to_i > 1
                    offset = 0
                    @item_pages.each do |pg|
                      page_boundaries[offset] = pg[:page]
                      offset += pg[:items].size
                    end
                  end
                  # Per-page sr counters so the display serial resets each page
                  page_item_counters = Hash.new(0)
                  current_page = 1
                %>
                <% items.each_with_index do |item, idx| %>
                  <%
                    if page_boundaries.key?(idx)
                      current_page = page_boundaries[idx]
                    end
                    page_item_counters[current_page] += 1
                  %>
                  <%
                    clean_code   = @supplier_profile.matcher.display_code(item)
                    match_key    = @match_key_fn&.call(item)
                    matched_prod = match_key.present? ? @product_map[match_key] : nil
                    matched      = matched_prod.present?
                    prod_uom     = matched_prod&.base_uom&.name.presence
                    display_uom  = prod_uom || item['unit'].presence || '—'
                    prod_gst_rate = matched_prod&.gst_rate.to_f
                    disc_amt     = item['discount_amount'].to_f
                    disc_pct     = item['discount_percent'].to_f

                    # Pack-based (Shalimar): the line Amount is the pre-GST taxable.
                    # Distribute the invoice-level cash discount % across each line so
                    # GST is charged on the post-discount amount and totals reconcile.
                    pb_gross_taxable = item['taxable_amount'].to_f > 0 ?
                                         item['taxable_amount'].to_f : item['total_amount'].to_f
                    pb_cash_disc_pct = hdr['cash_discount_percent'].to_f
                    if pack_based && disc_amt.zero? && pb_cash_disc_pct > 0 && pb_gross_taxable > 0
                      disc_amt = (pb_gross_taxable * pb_cash_disc_pct / 100.0).round(2)
                    end
                    # Effective per-line GST for pack-based: invoice rate → catalogue → 18% default
                    pb_gst_rate = prod_gst_rate > 0 ? prod_gst_rate : 18.0

                    is_duplicate = if generic
                      @duplicates&.any? { |d|
                        d['description'].to_s.downcase == item['description'].to_s.downcase &&
                        (d['quantity'].to_f - item['quantity'].to_f).abs < 0.001
                      }
                    else
                      @duplicates&.any? { |d|
                        d['material_code'].to_s == item['material_code'].to_s &&
                        (d['quantity'].to_f - item['quantity'].to_f).abs < 0.001
                      }
                    end

                    iv_qty   = item['quantity'].to_f
                    iv_rate  = item['unit_rate'].to_f
                    iv_total = item['total_amount'].to_f

                    item_warnings = []

                    if generic
                      # Others: qty × rate × (1 − disc%) ≈ amount
                      if iv_qty > 0 && iv_rate > 0 && iv_total > 0
                        exp = disc_pct > 0 ? (iv_qty * iv_rate * (1 - disc_pct / 100.0)).round(2) : (iv_qty * iv_rate).round(2)
                        item_warnings << "Amount ₹#{iv_total} ≠ Qty(#{iv_qty.to_i})×Rate(#{iv_rate})×(1−#{disc_pct}%)=₹#{exp}" if (exp - iv_total).abs > 1.0
                      end
                      iv_gst_rate = 0
                    else
                      # Standard/pack-based: four-step validation
                      iv_value    = item['value'].to_f
                      iv_disc     = disc_amt
                      iv_taxable  = item['taxable_amount'].to_f
                      iv_cgst_pct = item['cgst_percent'].to_f
                      iv_sgst_pct = item['sgst_percent'].to_f
                      iv_igst_pct = item['igst_percent'].to_f
                      iv_gst_rate = iv_cgst_pct + iv_sgst_pct + iv_igst_pct
                      iv_cgst_amt = item['cgst_amount'].to_f
                      iv_sgst_amt = item['sgst_amount'].to_f
                      iv_igst_amt = item['igst_amount'].to_f
                      iv_gst_amt  = iv_cgst_amt + iv_sgst_amt + iv_igst_amt

                      if iv_qty > 0 && iv_rate > 0 && iv_value > 0
                        exp_value = (iv_qty * iv_rate).round(2)
                        item_warnings << "Value ₹#{iv_value} ≠ Qty(#{iv_qty.to_i}) × Rate(#{iv_rate}) = ₹#{exp_value}" if (exp_value - iv_value).abs > 1.0
                      end
                      if iv_value > 0 && iv_taxable > 0
                        exp_taxable = (iv_value - iv_disc).round(2)
                        item_warnings << "Taxable ₹#{iv_taxable} ≠ Value(#{iv_value}) − Disc(#{iv_disc}) = ₹#{exp_taxable}" if (exp_taxable - iv_taxable).abs > 1.0
                      end
                      if iv_taxable > 0 && iv_gst_rate > 0 && iv_gst_amt > 0
                        exp_gst = (iv_taxable * iv_gst_rate / 100.0).round(2)
                        item_warnings << "GST ₹#{iv_gst_amt} ≠ #{iv_gst_rate.to_i}% × ₹#{iv_taxable} = ₹#{exp_gst}" if (exp_gst - iv_gst_amt).abs > 1.0
                      end
                      if iv_taxable > 0 && iv_total > 0
                        exp_total = (iv_taxable + iv_gst_amt).round(2)
                        item_warnings << "Total ₹#{iv_total} ≠ Taxable(₹#{iv_taxable}) + GST(₹#{iv_gst_amt}) = ₹#{exp_total}" if (exp_total - iv_total).abs > 1.0
                      end

                      # GST cross-check against the matched product's catalogue rate.
                      # Only flags when the invoice carries a per-line GST that disagrees
                      # with the catalogue. Shalimar items (per-line GST = 0) fall back to
                      # the catalogue rate for display rather than triggering a warning.
                      if matched && prod_gst_rate > 0 && iv_gst_rate > 0 &&
                         (iv_gst_rate - prod_gst_rate).abs > 1.0
                        item_warnings << "GST #{iv_gst_rate.to_i}% on invoice ≠ #{prod_gst_rate.to_i}% in catalogue"
                      end
                    end

                    item_has_issues = item_warnings.any? && !is_duplicate
                    sr_label        = item['sr_no'] || page_item_counters[current_page]
                  %>
                  <% if page_boundaries.key?(idx) %>
                    <tr>
                      <td colspan="<%= col_count %>"
                          style="padding:5px 12px;font-size:10px;font-weight:700;
                                 color:var(--text-dim);text-transform:uppercase;letter-spacing:.08em;
                                 background:var(--bg);border-bottom:1px solid var(--border);
                                 border-top:<%= idx > 0 ? '2px solid var(--border)' : 'none' %>">
                        Page <%= page_boundaries[idx] %>
                        <span style="font-weight:400;text-transform:none;letter-spacing:0;
                                     font-family:var(--mono);color:var(--text-dim)">
                          · <%= @item_pages[page_boundaries[idx] - 1][:items].size %> items
                        </span>
                      </td>
                    </tr>
                  <% end %>
                  <% if generic %>
                    <%= render 'item_row_others',
                          item: item, idx: idx, sr_label: sr_label,
                          matched: matched, display_uom: display_uom, disc_pct: disc_pct,
                          iv_rate: iv_rate,
                          is_duplicate: is_duplicate, item_warnings: item_warnings,
                          item_has_issues: item_has_issues, append_mode: append_mode %>
                  <% else %>
                    <%= render 'item_row_standard',
                          item: item, idx: idx, sr_label: sr_label,
                          clean_code: clean_code, matched: matched,
                          system_desc: matched_prod&.description,
                          display_uom: display_uom, disc_amt: disc_amt,
                          iv_rate: iv_rate, iv_gst_rate: iv_gst_rate,
                          prod_gst_rate: prod_gst_rate,
                          pb_gross_taxable: pb_gross_taxable, pb_gst_rate: pb_gst_rate,
                          is_duplicate: is_duplicate, item_warnings: item_warnings,
                          item_has_issues: item_has_issues, append_mode: append_mode,
                          pack_based: pack_based %>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>

          <%# Summary footer — uses rc_/ex_ variables computed in the reconciliation block above %>
          <div style="padding:14px 20px;border-top:1px solid var(--border);
                      display:flex;justify-content:flex-end;gap:28px;flex-wrap:wrap">
            <% if ex_taxable > 0 %>
              <div style="text-align:right">
                <div style="font-size:10px;color:var(--text-dim);font-family:var(--mono);
                            text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px">Taxable</div>
                <div style="font-family:var(--mono);font-size:15px;color:var(--text)">
                  Rs. <%= number_with_precision(ex_taxable, precision: 2, delimiter: ',') %>
                </div>
              </div>
            <% end %>
            <% if ex_cash_disc > 0 %>
              <div style="text-align:right">
                <div style="font-size:10px;color:var(--text-dim);font-family:var(--mono);
                            text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px">Cash Disc.</div>
                <div style="font-family:var(--mono);font-size:15px;color:var(--warning)">
                  — Rs. <%= number_with_precision(ex_cash_disc, precision: 2, delimiter: ',') %>
                </div>
              </div>
            <% elsif rc_cash_disc > 0 %>
              <div style="text-align:right">
                <div style="font-size:10px;color:var(--text-dim);font-family:var(--mono);
                            text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px">Total Disc.</div>
                <div style="font-family:var(--mono);font-size:15px;color:var(--warning)">
                  — Rs. <%= number_with_precision(rc_cash_disc, precision: 2, delimiter: ',') %>
                </div>
              </div>
            <% end %>
            <% if ex_cgst + ex_sgst > 0 %>
              <div style="text-align:right">
                <div style="font-size:10px;color:var(--text-dim);font-family:var(--mono);
                            text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px">CGST + SGST</div>
                <div style="font-family:var(--mono);font-size:15px;color:var(--text)">
                  Rs. <%= number_with_precision(ex_cgst + ex_sgst, precision: 2, delimiter: ',') %>
                </div>
              </div>
            <% end %>
            <div style="text-align:right">
              <div style="font-size:10px;color:var(--text-dim);font-family:var(--mono);
                          text-transform:uppercase;letter-spacing:.07em;margin-bottom:3px">
                Grand Total (computed)
              </div>
              <%# Primary figure is always the sum of line items — not the AI-extracted header value %>
              <div id="live-grand-total"
                   style="font-family:var(--mono);font-size:22px;font-weight:700;color:var(--accent)">
                Rs. <%= number_with_precision(computed_grand_total, precision: 2, delimiter: ',') %>
              </div>
              <% if total_mismatch %>
                <div style="font-size:10px;margin-top:3px;color:var(--warning);font-family:var(--mono)">
                  ⚠ Invoice says: Rs. <%= number_with_precision(extracted_grand_total, precision: 2, delimiter: ',') %>
                </div>
              <% elsif extracted_grand_total > 0 && extracted_grand_total != computed_grand_total %>
                <div style="font-size:10px;margin-top:3px;color:var(--text-dim);font-family:var(--mono)">
                  Invoice: Rs. <%= number_with_precision(extracted_grand_total, precision: 2, delimiter: ',') %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <% if hdr['amount_in_words'].present? %>
          <div style="font-size:12px;color:var(--text-dim);margin-bottom:16px;font-style:italic">
            In words: <%= hdr['amount_in_words'] %>
          </div>
        <% end %>

        <%# Validation error banner — shown by JS when submit is blocked %>
        <div id="validation-error-banner"
             style="display:none;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.4);
                    border-radius:8px;padding:12px 16px;margin-bottom:12px;
                    align-items:center;gap:10px">
          <span style="font-size:16px;flex-shrink:0">✗</span>
          <span id="validation-error-msg" style="font-size:13px;font-weight:600;color:#ef4444">
            Some items have calculation errors. Fix them before saving.
          </span>
        </div>

        <%# Submit bar %>
        <div style="display:flex;gap:12px;align-items:center;padding:20px 0">
          <button type="submit" class="btn btn-primary" id="save-btn-bottom">
            <%= append_mode ? 'Append Items to Invoice →' : 'Save as Draft Invoice →' %>
          </button>
          <%= link_to 'Cancel', purchasing_digitise_index_path, class: 'btn btn-secondary' %>
          <span style="font-size:12px;color:var(--text-dim)">
            <%= append_mode ? 'New items will be appended to the existing draft invoice.' : 'Saved as draft. Confirm from the invoice detail page to update stock.' %>
          </span>
        </div>

  <% end %><%# end form %>

  <%# ── LIGHTBOX OVERLAY ── %>
  <div id="lb-overlay" onclick="if(event.target===this)lbClose()">
    <button id="lb-close" onclick="lbClose()" title="Close (Esc)">✕</button>
    <div style="width:100%;max-width:900px">
      <div id="lb-images"></div>
    </div>
  </div>

  <script>
    // Images passed from the controller — one entry per session import
    var LB_IMAGES = <%= raw @lightbox_images.to_json %>;

    (function buildLightbox() {
      var container = document.getElementById('lb-images');
      LB_IMAGES.forEach(function(img, i) {
        var wrap  = document.createElement('div');
        wrap.className = 'lb-img-wrap';

        var label = document.createElement('div');
        label.className = 'lb-label';
        label.textContent = img.label +
          (LB_IMAGES.length > 1 ? '  —  image ' + (i + 1) + ' of ' + LB_IMAGES.length : '');

        var el = document.createElement('img');
        el.src = img.src;
        el.alt = img.label;

        var counter = document.createElement('div');
        counter.className = 'lb-counter';
        if (LB_IMAGES.length > 1) {
          counter.textContent = (i + 1) + ' / ' + LB_IMAGES.length;
        }

        wrap.appendChild(label);
        wrap.appendChild(el);
        wrap.appendChild(counter);
        container.appendChild(wrap);
      });
    })();

    function lbOpen() {
      if (!LB_IMAGES.length) return;
      document.getElementById('lb-overlay').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function lbClose() {
      document.getElementById('lb-overlay').classList.remove('open');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') lbClose();
    });

    // ── Pack-based (Shalimar): taxable is editable; derive GST + total ───────
    //   net = taxable − cash_disc ; total = net × (1 + gst%/100)
    function autoComputePack(idx) {
      var taxEl  = document.getElementById('item-taxable-' + idx);
      var discEl = document.getElementById('item-disc-'    + idx);
      var gstEl  = document.getElementById('item-gst-'     + idx);
      var totEl  = document.getElementById('item-total-'   + idx);
      if (!taxEl || !totEl) return;

      var taxable = parseFloat(taxEl.value)  || 0;
      var disc    = parseFloat(discEl ? discEl.value : '0') || 0;
      var gst     = parseFloat(gstEl  ? gstEl.value  : '0') || 0;

      var net = taxable - disc;
      if (net < 0) net = 0;
      totEl.value = (Math.round(net * (1 + gst / 100) * 100) / 100).toFixed(2);

      revalidateRow(idx);
    }

    // ── Others: auto-compute total from qty × rate × (1 − disc%) ────────────
    function autoComputeOthers(idx) {
      var rateEl  = document.getElementById('item-rate-'  + idx);
      var qtyEl   = document.getElementById('item-qty-'   + idx);
      var discEl  = document.getElementById('item-disc-'  + idx);
      var totalEl = document.getElementById('item-total-' + idx);
      if (!rateEl || !qtyEl || !totalEl) return;

      var rate = parseFloat(rateEl.value) || 0;
      var qty  = parseFloat(qtyEl.value)  || 0;
      var disc = parseFloat(discEl ? discEl.value : '0') || 0;

      if (rate > 0 && qty > 0) {
        var newTotal = Math.round(qty * rate * (1 - disc / 100) * 100) / 100;
        totalEl.value = newTotal.toFixed(2);
      }
      revalidateRow(idx);
    }

    // ── Per-row client-side validation ───────────────────────────────────────
    // Formula: qty * rate − disc = taxable; taxable * (1 + gst%/100) = total
    function revalidateRow(idx) {
      var tr    = document.getElementById('item-row-'  + idx);
      var badge = document.getElementById('item-badge-' + idx);
      // Update ONLY the status-icon span, never the whole cell — otherwise the
      // remove (×) button, Undo link and hidden _excluded flag get destroyed.
      var statusIcon = badge ? badge.querySelector('.status-icon') : null;
      if (!tr || tr.dataset.duplicate === '1') return;
      // Excluded rows keep their faded state — don't re-style or re-badge them
      var exFlag = tr.querySelector('.excluded-flag');
      if (exFlag && exFlag.value === '1') return;

      var rate    = parseFloat(tr.dataset.rate)    || 0;

      var qtyEl   = document.getElementById('item-qty-'   + idx);
      var discEl  = document.getElementById('item-disc-'  + idx);
      var totalEl = document.getElementById('item-total-' + idx);
      var gstEl   = document.getElementById('item-gst-'   + idx);
      // Prefer the editable GST input; fall back to the row's original rate
      var gstRate = gstEl ? (parseFloat(gstEl.value) || 0) : (parseFloat(tr.dataset.gstRate) || 0);

      var qty   = parseFloat(qtyEl   ? qtyEl.value   : '0') || 0;
      var disc  = parseFloat(discEl  ? discEl.value  : '0') || 0;
      var total = parseFloat(totalEl ? totalEl.value : '0') || 0;

      var isPctDisc = discEl && discEl.classList.contains('disc-pct-input');

      var warnings = [];

      if (isPctDisc) {
        // Others: rate lives in its own editable input (item-rate-idx)
        var rateEl = document.getElementById('item-rate-' + idx);
        var effectiveRate = rateEl ? (parseFloat(rateEl.value) || 0) : 0;
        if (effectiveRate > 0 && qty > 0 && total > 0) {
          var expectedTotal = Math.round(qty * effectiveRate * (1 - disc / 100) * 100) / 100;
          if (Math.abs(expectedTotal - total) > 1.0) {
            warnings.push(
              'Expected ₹' + expectedTotal.toFixed(2) +
              ' (qty ' + qty + ' × rate ' + effectiveRate.toFixed(2) +
              (disc > 0 ? ' × (1−' + disc + '%)' : '') + ')'
            );
          }
        }
      } else {
        // Standard (AP) uses qty × rate as gross; pack-based (Shalimar) uses the
        // editable Taxable input as gross. Both: (gross − disc) × (1 + gst%) = total
        var taxableEl = document.getElementById('item-taxable-' + idx);
        var gross = taxableEl ? (parseFloat(taxableEl.value) || 0) : (qty * rate);
        if (gross > 0 && total > 0) {
          var taxable = Math.round((gross - disc) * 100) / 100;
          var expectedTotal = Math.round(taxable * (1 + gstRate / 100) * 100) / 100;
          if (Math.abs(expectedTotal - total) > 1.0) {
            warnings.push(
              'Expected ₹' + expectedTotal.toFixed(2) +
              ' (taxable ₹' + taxable.toFixed(2) +
              (gstRate > 0 ? ' + ' + gstRate + '% GST' : '') + ')'
            );
          }
        }
      }

      var hasIssues = warnings.length > 0;
      tr.dataset.hasIssues = hasIssues ? '1' : '0';

      if (hasIssues) {
        tr.style.background = 'rgba(239,68,68,0.14)';
        tr.style.borderLeft = '4px solid #ef4444';
        if (statusIcon) statusIcon.innerHTML =
          '<span title="' + escHtml(warnings.join(' | ')) + '" ' +
          'style="font-size:10px;color:#ef4444;font-family:var(--mono);' +
          'font-weight:700;cursor:help">⚠ ERR</span>';
      } else {
        tr.style.background = '';
        tr.style.borderLeft = '';
        if (statusIcon) statusIcon.innerHTML =
          '<span style="font-size:10px;color:var(--success);' +
          'font-family:var(--mono);font-weight:600">✓</span>';
      }

      updateReconciliation();
    }

    // ── Live reconciliation — full client-side recompute ─────────────────────
    // Recomputes taxable / GST / cash-discount / grand total from the CURRENT
    // (non-excluded, non-duplicate) rows, then refreshes every reconciliation
    // cell and its ✓/⚠/✗ status. Runs on any row edit and on exclude/restore.
    function fmtMoney(v) {
      return (Math.round(v * 100) / 100).toLocaleString('en-IN', {
        minimumFractionDigits: 2, maximumFractionDigits: 2
      });
    }
    function setRecCell(id, val) {
      var el = document.getElementById(id);
      if (el) el.textContent = fmtMoney(val);
    }
    // Same tolerances as the server's rec_st lambda: ≤1.5 ok, ≤10 warn, else error.
    function statusOf(computed, extracted) {
      if (extracted <= 0) return 'na';
      var d = Math.abs(computed - extracted);
      return d <= 1.5 ? 'ok' : (d <= 10.0 ? 'warn' : 'error');
    }
    function setRecStatus(id, computed, extracted) {
      var el = document.getElementById(id);
      if (!el) return;
      var map = { na:  ['—', 'var(--text-dim)'], ok: ['✓', 'var(--success)'],
                  warn: ['⚠', 'var(--warning)'], error: ['✗', 'var(--danger)'] };
      var s = map[statusOf(computed, extracted)];
      el.textContent = s[0];
      el.style.color = s[1];
    }

    function updateReconciliation() {
      var rcComp = document.getElementById('rec-computed-total');
      if (!rcComp) return;

      var gstMode     = rcComp.dataset.gstMode || 'per_line';
      var summaryRate = parseFloat(rcComp.dataset.summaryGstRate) || 0;
      var isInter     = rcComp.dataset.gstSplit === 'inter';
      var exCashDisc  = parseFloat(rcComp.dataset.exCashDisc) || 0;
      var exTaxable   = parseFloat(rcComp.dataset.exTaxable)  || 0;
      var exGst       = parseFloat(rcComp.dataset.exGst)      || 0;
      var exTotal     = parseFloat(rcComp.dataset.exTotal)    || 0;

      var sumTaxable = 0, sumGst = 0, sumDisc = 0, sumLineTotal = 0;

      document.querySelectorAll('tr[id^="item-row-"]').forEach(function(row) {
        var flag = row.querySelector('.excluded-flag');
        if (flag && flag.value === '1') return;        // skip excluded
        if (row.dataset.duplicate === '1') return;      // skip duplicates

        var idx    = row.id.replace('item-row-', '');
        var qtyEl  = document.getElementById('item-qty-'     + idx);
        var discEl = document.getElementById('item-disc-'    + idx);
        var gstEl  = document.getElementById('item-gst-'     + idx);
        var totEl  = document.getElementById('item-total-'   + idx);
        var taxEl  = document.getElementById('item-taxable-' + idx);

        var qty   = parseFloat(qtyEl  ? qtyEl.value  : '0') || 0;
        var disc  = parseFloat(discEl ? discEl.value : '0') || 0;
        var total = parseFloat(totEl  ? totEl.value  : '0') || 0;
        var rate  = parseFloat(row.dataset.rate) || 0;
        var gstPct = parseFloat(gstEl ? gstEl.value : '0') || 0;
        var isPctDisc = discEl && discEl.classList.contains('disc-pct-input');

        sumLineTotal += total;

        if (gstMode === 'summary') {
          // Per-line GST is 0; the line total is the pre-GST taxable amount.
          sumTaxable += total;
          if (!isPctDisc) sumDisc += disc;
        } else {
          // per_line: gross taxable = editable Taxable input (Shalimar) or qty×rate (AP)
          // net = gross − disc ; gst = net × gst%/100 ; rec-taxable shows net (post-disc)
          var gross = taxEl ? (parseFloat(taxEl.value) || 0) : (qty * rate);
          var lineTaxable = Math.round((gross - disc) * 100) / 100;
          if (lineTaxable < 0) lineTaxable = 0;
          sumTaxable += lineTaxable;
          sumGst     += Math.round(lineTaxable * gstPct / 100 * 100) / 100;
          sumDisc    += disc;
        }
      });

      var gstTotal, grandTotal;
      if (gstMode === 'summary') {
        gstTotal   = summaryRate > 0 ? sumTaxable * summaryRate / 100 : 0;
        grandTotal = sumTaxable + gstTotal;
      } else {
        gstTotal   = sumGst;
        grandTotal = sumLineTotal;   // per-line totals already include GST
      }

      // Update value cells (each setter no-ops if the cell isn't rendered)
      setRecCell('rec-cash-disc', sumDisc);
      setRecCell('rec-taxable',   sumTaxable);
      if (isInter) {
        setRecCell('rec-igst', gstTotal);
      } else {
        setRecCell('rec-cgst', gstTotal / 2);
        setRecCell('rec-sgst', gstTotal / 2);
      }
      setRecCell('rec-gst-total',      gstTotal);
      setRecCell('rec-computed-total', grandTotal);

      // Refresh statuses
      setRecStatus('rec-cash-disc-status', sumDisc,    exCashDisc);
      setRecStatus('rec-taxable-status',   sumTaxable, exTaxable);
      setRecStatus('rec-gst-status',       gstTotal,   exGst);
      setRecStatus('rec-total-status',     grandTotal, exTotal);

      // ── Overall verdict banner ──────────────────────────────────────────
      var stCashDisc = (sumDisc > 0 || exCashDisc > 0) ? statusOf(sumDisc, exCashDisc) : 'na';
      var stTaxable  = statusOf(sumTaxable, exTaxable);
      var stGst      = statusOf(gstTotal,   exGst);
      var stTotal    = statusOf(grandTotal, exTotal);

      var active = [stCashDisc, stTaxable, stGst, stTotal].filter(function(s) { return s !== 'na'; });
      var hasErr = active.indexOf('error') !== -1;
      var allOk  = active.length > 0 && active.every(function(s) { return s === 'ok'; });

      var banner = document.getElementById('rec-banner');
      if (banner) {
        if (hasErr) {
          banner.textContent = '✗ Issues found — check highlighted items';
          banner.style.color = 'var(--danger)';
        } else if (allOk) {
          banner.textContent = '✓ All checks passed';
          banner.style.color = 'var(--success)';
        } else {
          banner.textContent = '⚠ Minor differences';
          banner.style.color = 'var(--warning)';
        }
      }

      // ── Footnote (rounding note / mismatch note / hidden) ────────────────
      var footnote = document.getElementById('rec-footnote');
      if (footnote) {
        var diff = Math.abs(grandTotal - exTotal);
        if (exTotal > 0 && diff >= 0.01 && diff <= 2.0 && stTotal !== 'error') {
          footnote.textContent = 'Difference Rs. ' + fmtMoney(diff) + ' — commercial rounding applied by supplier';
          footnote.style.color = 'var(--text-dim)';
          footnote.style.display = '';
        } else if (stTotal === 'error') {
          footnote.textContent = 'Diff Rs. ' + fmtMoney(diff) +
            ' — pages may be missing or AI misread a column. Check quantities carefully.';
          footnote.style.color = 'var(--danger)';
          footnote.style.display = '';
        } else {
          footnote.style.display = 'none';
        }
      }

      // Keep the form-footer grand total in sync
      var liveEl = document.getElementById('live-grand-total');
      if (liveEl) liveEl.textContent = 'Rs. ' + fmtMoney(grandTotal);
    }

    function escHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ── Form submit guard ─────────────────────────────────────────────────────
    (function() {
      var form = document.getElementById('confirm-form');
      if (!form) return;
      form.addEventListener('submit', function(e) {
        var badRows = document.querySelectorAll('[data-has-issues="1"]:not([data-duplicate="1"])');
        if (badRows.length === 0) return;
        e.preventDefault();
        var label = badRows.length + ' line item' + (badRows.length > 1 ? 's' : '') +
          ' mismatched. Are you sure you want to proceed?';
        if (confirm(label)) {
          form.removeEventListener('submit', arguments.callee);
          form.submit();
        } else {
          badRows[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    })();

    // ── EXCLUDE / RESTORE ITEM ROWS ────────────────────────────────────────
    window.excludeItem = function(idx) {
      var row   = document.getElementById('item-row-' + idx);
      var flag  = row ? row.querySelector('.excluded-flag') : null;
      var undo  = document.getElementById('undo-' + idx);
      var btn   = row ? row.querySelector('.exclude-btn') : null;
      if (!row || !flag) return;

      flag.value = '1';
      row.style.opacity         = '0.3';
      row.style.textDecoration  = 'line-through';
      row.style.pointerEvents   = 'none';
      if (btn)  btn.style.display  = 'none';
      if (undo) undo.style.display = 'block';

      refreshAfterExclusion();
    };

    window.restoreItem = function(idx) {
      var row  = document.getElementById('item-row-' + idx);
      var flag = row ? row.querySelector('.excluded-flag') : null;
      var undo = document.getElementById('undo-' + idx);
      var btn  = row ? row.querySelector('.exclude-btn') : null;
      if (!row || !flag) return;

      flag.value = '0';
      row.style.opacity        = '';
      row.style.textDecoration = '';
      row.style.pointerEvents  = '';
      if (btn)  btn.style.display  = '';
      if (undo) undo.style.display = 'none';

      refreshAfterExclusion();
    };

    // Re-run every visible row's validation, then recompute the whole
    // reconciliation panel — so excluding/restoring a line cascades through
    // all totals, GST, and ✓/⚠/✗ statuses client-side.
    function refreshAfterExclusion() {
      document.querySelectorAll('tr[id^="item-row-"]').forEach(function(row) {
        var flag = row.querySelector('.excluded-flag');
        if (flag && flag.value === '1') return;
        var idx = row.id.replace('item-row-', '');
        revalidateRow(idx);
      });
      updateReconciliation();
    }

    // ── INIT ON LOAD (pack-based only) ─────────────────────────────────────
    // Shalimar rows compute Total from the editable Taxable, then the whole
    // reconciliation panel is recomputed so it reflects the per-line model
    // (net taxable, per-line GST, distributed cash discount) immediately.
    // Standard/AP invoices are left on their server-rendered values.
    (function initPackReconciliation() {
      var taxInputs = document.querySelectorAll('input[id^="item-taxable-"]');
      if (taxInputs.length === 0) return;
      taxInputs.forEach(function(taxEl) {
        autoComputePack(taxEl.id.replace('item-taxable-', ''));
      });
      if (document.getElementById('rec-computed-total')) updateReconciliation();
    })();
  </script>

<% end %>
