<%# app/views/purchasing/digitise/new.html.erb %>
<% content_for :title, "Scan Bill" %>
<% content_for :breadcrumb do %>
  <span style="color:var(--text-dim)">Purchasing</span>
  <span class="breadcrumb-sep">/</span>
  <%= link_to 'Digitise', purchasing_digitise_index_path, style: "color:var(--text-dim)" %>
  <span class="breadcrumb-sep">/</span>
  <span class="breadcrumb-current">Scan Bill</span>
<% end %>

<style>
  /* ── Supplier selector ─────────────────────────────────────────── */
  .supplier-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 22px;
    margin-bottom: 20px;
    position: relative;
  }
  .supplier-card-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .supplier-options {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .supplier-option {
    flex: 1;
    min-width: 160px;
    position: relative;
    cursor: pointer;
  }
  .supplier-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .supplier-option-label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 2px solid var(--border);
    border-radius: 9px;
    cursor: pointer;
    transition: all 0.18s ease;
    background: var(--bg);
    user-select: none;
  }
  .supplier-option-label:hover {
    border-color: rgba(79,142,247,0.5);
    background: rgba(79,142,247,0.04);
  }
  .supplier-option input[type="radio"]:checked + .supplier-option-label {
    border-color: var(--accent);
    background: rgba(79,142,247,0.08);
    box-shadow: 0 0 0 3px rgba(79,142,247,0.12);
  }
  .supplier-option-icon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
    font-family: var(--mono);
    flex-shrink: 0;
  }
  .supplier-option-text { flex: 1; }
  .supplier-option-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 2px;
  }
  .supplier-option-desc {
    font-size: 10px;
    color: var(--text-dim);
  }
  .supplier-option-check {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
  }
  .supplier-option input[type="radio"]:checked + .supplier-option-label .supplier-option-check {
    border-color: var(--accent);
    background: var(--accent);
  }
  .supplier-option input[type="radio"]:checked + .supplier-option-label .supplier-option-check::after {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #fff;
    display: block;
  }

  /* ── Scanner animation ─────────────────────────────────────────── */
  .scanner-panel {
    position: sticky;
    top: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px 20px;
    text-align: center;
  }
  .scanner-panel-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: 24px;
  }
  .scanner-wrap {
    display: inline-block;
    position: relative;
    margin: 0 auto 20px;
  }
  /* The scanner device body */
  .scanner-body {
    width: 180px;
    height: 240px;
    background: linear-gradient(160deg, #1e2130 0%, #151825 100%);
    border: 2px solid rgba(79,142,247,0.25);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06);
  }
  /* Top slot where paper enters */
  .scanner-slot {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 6px;
    background: rgba(0,0,0,0.6);
    border-radius: 0 0 4px 4px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.5);
    z-index: 10;
  }
  /* Scanbed glass area */
  .scanner-glass {
    position: absolute;
    top: 16px;
    left: 14px;
    right: 14px;
    bottom: 30px;
    background: rgba(10,14,30,0.7);
    border-radius: 6px;
    border: 1px solid rgba(79,142,247,0.15);
    overflow: hidden;
  }
  /* The A4 paper */
  .scanner-paper {
    position: absolute;
    left: 50%;
    width: 108px;
    height: 152px;
    background: #f8f9fc;
    border-radius: 2px;
    transform: translateX(-50%) translateY(-160px);
    animation: paperCycle 4s ease-in-out infinite;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    overflow: hidden;
  }
  /* Paper content lines */
  .paper-line {
    position: absolute;
    left: 10px;
    height: 4px;
    border-radius: 2px;
    background: #c8d0dc;
    opacity: 0;
    animation: lineReveal 4s ease-in-out infinite;
  }
  /* Scanning light beam */
  .scan-beam {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(to right,
      transparent 0%,
      rgba(79,142,247,0.3) 15%,
      rgba(79,142,247,0.9) 50%,
      rgba(79,142,247,0.3) 85%,
      transparent 100%
    );
    box-shadow: 0 0 12px 4px rgba(79,142,247,0.4);
    animation: beamSweep 4s ease-in-out infinite;
    opacity: 0;
    z-index: 5;
  }
  /* Glow on scanner body when scanning */
  .scanner-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(79,142,247,0.07) 0%, transparent 70%);
    animation: glowPulse 4s ease-in-out infinite;
    pointer-events: none;
  }
  /* Bottom LED strip */
  .scanner-led {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
  }
  .scanner-led span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(79,142,247,0.3);
    animation: ledBlink 4s ease-in-out infinite;
  }
  .scanner-led span:nth-child(2) { animation-delay: 0.3s; }
  .scanner-led span:nth-child(3) { animation-delay: 0.6s; }

  /* Status label */
  .scan-status {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    font-family: var(--mono);
    height: 18px;
    animation: statusCycle 4s ease-in-out infinite;
  }
  .scanner-tags {
    display: flex;
    gap: 6px;
    justify-content: center;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .scanner-tag {
    font-size: 10px;
    font-weight: 600;
    font-family: var(--mono);
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: .04em;
  }

  /* ── Keyframes ─────────────────────────────────────────────────── */
  @keyframes paperCycle {
    0%            { transform: translateX(-50%) translateY(-160px); }
    18%, 75%      { transform: translateX(-50%) translateY(4px); }
    93%, 100%     { transform: translateX(-50%) translateY(-160px); }
  }
  @keyframes beamSweep {
    0%, 15%       { top: 4px;   opacity: 0; }
    20%           { top: 4px;   opacity: 1; }
    70%           { top: 148px; opacity: 1; }
    78%, 100%     { top: 148px; opacity: 0; }
  }
  @keyframes lineReveal {
    0%, 18%    { opacity: 0; }
    22%, 78%   { opacity: 1; }
    85%, 100%  { opacity: 0; }
  }
  @keyframes glowPulse {
    0%, 15%     { opacity: 0; }
    25%, 70%    { opacity: 1; }
    85%, 100%   { opacity: 0; }
  }
  @keyframes ledBlink {
    0%, 15%     { background: rgba(79,142,247,0.2); }
    20%, 75%    { background: rgba(79,142,247,0.9);
                  box-shadow: 0 0 6px rgba(79,142,247,0.8); }
    85%, 100%   { background: rgba(79,142,247,0.2); }
  }
  @keyframes statusCycle {
    0%, 17%    { opacity: 0; }
    20%, 40%   { opacity: 1; }
    45%, 65%   { opacity: 0.4; }
    70%, 78%   { opacity: 1; }
    85%, 100%  { opacity: 0; }
  }

  /* ── Supplier modal ─────────────────────────────────────────── */
  #supplier-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.72);
    align-items: center;
    justify-content: center;
  }
  #supplier-modal.open { display: flex; }
  .modal-sup-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border: 2px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    background: var(--bg);
    margin-bottom: 8px;
    user-select: none;
  }
  .modal-sup-card:hover { border-color: rgba(79,142,247,0.5); background: rgba(79,142,247,0.04); }
  .modal-sup-card.selected { border-color: var(--accent); background: rgba(79,142,247,0.07); }
  .sup-badge-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 16px;
    max-width: 820px;
    margin-bottom: 20px;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .sup-badge-bar:hover { border-color: rgba(79,142,247,0.4); }
</style>

<div class="page-header">
  <div>
    <div class="page-title">Scan a Purchase Bill</div>
    <div class="page-subtitle">Upload a PDF or one/more photos — AI extracts all data in ~15 seconds</div>
  </div>
  <%= link_to '← All Scans', purchasing_digitise_index_path, class: 'btn btn-secondary' %>
</div>

<%# ── SUPPLIER SELECTOR — top of page, outside the two-column grid ── %>
<%= form_with url: purchasing_digitise_index_path, method: :post,
      multipart: true, local: true, id: 'upload-form' do |f| %>

  <%# Hidden field posted with the form — value set by JS when user picks a supplier %>
  <input type="hidden" name="supplier_hint" id="supplier-hint-input" value="">

  <%# Selected-supplier badge — click to reopen the modal %>
  <div class="sup-badge-bar" onclick="openSupplierModal()" title="Click to change supplier">
    <div id="sup-badge-icon"
         style="width:38px;height:38px;border-radius:8px;display:flex;align-items:center;
                justify-content:center;font-size:14px;font-weight:800;font-family:var(--mono);
                flex-shrink:0;background:rgba(107,114,128,0.12);color:#6b7280">
      ?
    </div>
    <div style="flex:1;min-width:0">
      <div style="font-size:10px;font-weight:700;color:var(--text-dim);text-transform:uppercase;
                  letter-spacing:.07em;margin-bottom:3px">Supplier</div>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span id="sup-badge-name"
              style="font-size:14px;font-weight:600;color:var(--text)">
          Others
        </span>
        <span id="sup-badge-tagline"
              style="font-size:11px;color:var(--text-dim)">
          Works for any supplier
        </span>
      </div>
    </div>
    <button type="button"
            style="font-size:11px;font-weight:600;color:var(--accent);
                   background:rgba(79,142,247,0.08);border:1px solid rgba(79,142,247,0.25);
                   border-radius:6px;padding:5px 14px;cursor:pointer;white-space:nowrap;
                   flex-shrink:0">
      Change
    </button>
  </div>

  <%# ── TWO-COLUMN GRID ── %>
  <div style="display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:20px;
              align-items:start;max-width:820px">

    <%# LEFT — upload form %>
    <div>
      <div class="form-card" style="margin-bottom:16px">
        <div class="form-section">
          <div class="form-section-title">Upload Bill</div>

          <%# Drop zone %>
          <div id="drop-zone"
               style="border:2px dashed var(--accent-dim);border-radius:10px;padding:36px 24px;
                      text-align:center;cursor:pointer;transition:all 0.2s;margin-bottom:16px"
               onclick="document.getElementById('file-input').click()"
               ondragover="onDragOver(event)"
               ondragleave="onDragLeave(event)"
               ondrop="onDrop(event)">
            <svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.2"
                 viewBox="0 0 24 24" style="color:var(--accent);margin:0 auto 12px;display:block">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <div style="font-size:15px;font-weight:500;color:var(--text);margin-bottom:4px">
              Drop files here or click to browse
            </div>
            <div style="font-size:12px;color:var(--text-dim);margin-bottom:4px">
              PDF · JPG · PNG · WEBP — up to 10 MB each
            </div>
            <div style="font-size:11px;color:var(--accent);font-weight:500">
              Select multiple images for multi-page bills
            </div>
            <div id="file-chosen" style="margin-top:14px;display:none"></div>
          </div>

          <input type="file" id="file-input" name="files[]"
                 accept=".pdf,.jpg,.jpeg,.png,.webp"
                 multiple
                 style="display:none"
                 onchange="onFileChosen(this)">

          <%# File type badges %>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px">
            <% [
              ['PDF', 'var(--danger)',  'Multi-page supported'],
              ['JPG', 'var(--warning)', 'Multi-file supported'],
              ['PNG', 'var(--accent)',  'Multi-file supported'],
              ['WEBP','var(--success)', 'Multi-file supported']
            ].each do |fmt, colour, tip| %>
              <span title="<%= tip %>"
                    style="font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:0.05em;
                           background:rgba(255,255,255,0.04);border:1px solid var(--border);
                           border-radius:4px;padding:3px 8px;color:<%= colour %>">
                <%= fmt %>
              </span>
            <% end %>
          </div>

          <%# Multi-page tip %>
          <div style="background:rgba(79,142,247,0.06);border:1px solid rgba(79,142,247,0.2);
                      border-radius:8px;padding:12px 14px;margin-bottom:18px;font-size:12px;
                      color:var(--text-dim);line-height:1.6">
            <strong style="color:var(--accent)">Multi-page invoices:</strong>
            Upload a single PDF, or select all page images at once.
          </div>

          <div style="display:flex;gap:10px;align-items:center">
            <button type="submit" id="submit-btn" class="btn btn-primary" disabled
                    style="opacity:0.5;transition:opacity 0.2s">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
              </svg>
              Scan with AI
            </button>
            <%= link_to 'Cancel', purchasing_digitise_index_path, class: 'btn btn-secondary' %>
            <span id="uploading-msg" style="display:none;font-size:12px;color:var(--text-dim);
                                            font-family:var(--mono)">
              Uploading…
            </span>
          </div>

        </div>
      </div>

      <%# How it works %>
      <div class="form-card">
        <div class="form-section">
          <div class="form-section-title">How it works</div>
          <div style="display:flex;flex-direction:column;gap:14px">
            <% [
              ['1', 'Select supplier', 'Pick your supplier above for a tailored extraction prompt.', 'var(--accent)'],
              ['2', 'Upload bill',  'Drop a PDF or photo — multi-page and multi-image both work.', 'var(--warning)'],
              ['3', 'AI reads it',     'AI vision extracts every line item from the image.', 'var(--success)'],
              ['4', 'Review & save',   'Check values, fix errors, then save as a draft purchase bill.', 'var(--text-dim)'],
            ].each do |num, title, desc, colour| %>
              <div style="display:flex;gap:12px;align-items:flex-start">
                <div style="width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.05);
                            border:1px solid var(--border);display:flex;align-items:center;justify-content:center;
                            font-family:var(--mono);font-size:11px;font-weight:700;color:<%= colour %>;
                            flex-shrink:0;margin-top:1px"><%= num %></div>
                <div>
                  <div style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:3px"><%= title %></div>
                  <div style="font-size:12px;color:var(--text-dim)"><%= desc %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# RIGHT — scanner animation panel %>
    <div class="scanner-panel">
      <div class="scanner-panel-title">AI Bill Scanner</div>

      <div class="scanner-wrap">
        <div class="scanner-body">
          <div class="scanner-glow"></div>
          <div class="scanner-slot"></div>
          <div class="scanner-glass">
            <%# The paper with content lines %>
            <div class="scanner-paper">
              <%# Simulate invoice header area %>
              <div style="position:absolute;top:8px;left:8px;right:8px;height:18px;
                          background:rgba(180,190,210,0.5);border-radius:2px;
                          animation:lineReveal 4s ease-in-out infinite;opacity:0"></div>
              <%# Data rows — each with different widths and staggered delays %>
              <% rows = [
                [14, 88, 0.0], [20, 72, 0.05], [20, 60, 0.05],
                [26, 80, 0.1], [30, 65, 0.12], [34, 75, 0.15],
                [38, 55, 0.18], [42, 82, 0.2],  [46, 68, 0.22],
                [50, 50, 0.25], [54, 78, 0.28], [58, 62, 0.3],
                [62, 70, 0.32], [66, 55, 0.35], [70, 80, 0.37],
                [74, 45, 0.4],  [78, 72, 0.42], [82, 60, 0.45],
                [86, 68, 0.47], [90, 50, 0.5],  [94, 75, 0.52],
                [98, 40, 0.55], [102, 65, 0.57],[106, 80, 0.6],
                [110, 55, 0.62],[114, 70, 0.65],[118, 48, 0.67],
                [122, 72, 0.7], [126, 60, 0.72],[130, 85, 0.75],
                [134, 50, 0.77],[138, 68, 0.8], [142, 55, 0.82]
              ] %>
              <% rows.each do |top, width, delay| %>
                <div class="paper-line"
                     style="top:<%= top %>px;width:<%= width %>px;
                            animation-delay:<%= delay %>s"></div>
              <% end %>
            </div>
            <%# Scan beam %>
            <div class="scan-beam"></div>
          </div>
          <div class="scanner-led">
            <span></span><span></span><span></span>
          </div>
        </div>
      </div>

      <div class="scan-status">Scanning bill…</div>

      <div class="scanner-tags" style="margin-top:16px">
        <span class="scanner-tag"
              style="background:rgba(79,142,247,0.1);color:var(--accent);border:1px solid rgba(79,142,247,0.25)">
          Vision AI
        </span>
        <span class="scanner-tag"
              style="background:rgba(72,199,142,0.1);color:var(--success);border:1px solid rgba(72,199,142,0.25)">
          ImageMagick
        </span>
        <span class="scanner-tag"
              style="background:rgba(247,195,79,0.1);color:var(--warning);border:1px solid rgba(247,195,79,0.25)">
          AI
        </span>
      </div>

      <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border);
                  font-size:11px;color:var(--text-dim);line-height:1.7;text-align:left">
        <div style="margin-bottom:4px">
          <span style="color:var(--success)">✓</span> ImageMagick enhance
        </div>
        <div style="margin-bottom:4px">
          <span style="color:var(--success)">✓</span> Vision model parse
        </div>
        <div>
          <span style="color:var(--success)">✓</span> Math validation
        </div>
      </div>
    </div>

  </div><%# end grid %>

<% end %><%# end form %>

<%# ── Supplier selection modal ── %>
<div id="supplier-modal">
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;
              padding:28px 32px;max-width:480px;width:92%;
              box-shadow:0 24px 64px rgba(0,0,0,0.55)">

    <div style="margin-bottom:22px">
      <div style="font-size:17px;font-weight:700;color:var(--text);margin-bottom:5px">
        Select Supplier
      </div>
      <div style="font-size:12px;color:var(--text-dim);line-height:1.5">
        Choose the correct supplier for the best AI extraction accuracy.
        You can change this later.
      </div>
    </div>

    <% Suppliers::Registry.all.each do |profile| %>
      <%
        is_generic = profile.slug == 'generic'
        val        = profile.display_name
        hex        = profile.icon_colour.sub(/\A#/, '')
        ir, ig, ib = [0, 2, 4].map { |i| hex[i, 2].to_i(16) }
        icon_st    = "background:rgba(#{ir},#{ig},#{ib},0.15);color:#{profile.icon_colour}"
        icon_st   += ';font-size:11px' if profile.icon_initials.length > 1
        onclick    = "selectSupplier('#{profile.slug}',#{val.to_json},#{profile.display_name.to_json},#{profile.icon_initials.to_json},#{profile.icon_colour.to_json},#{profile.tagline.to_json})"
      %>
      <div class="modal-sup-card<%= is_generic ? ' selected' : '' %>"
           id="modal-card-<%= profile.slug %>"
           onclick="<%= onclick %>">
        <div style="<%= icon_st %>;width:40px;height:40px;border-radius:9px;
                    display:flex;align-items:center;justify-content:center;
                    font-weight:800;font-family:var(--mono);flex-shrink:0">
          <%= profile.icon_initials %>
        </div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;font-weight:600;color:var(--text)">
            <%= profile.display_name %>
          </div>
          <div style="font-size:11px;color:var(--text-dim);margin-top:2px">
            <%= profile.tagline %>
          </div>
        </div>
        <div id="modal-check-<%= profile.slug %>"
             style="width:20px;height:20px;border-radius:50%;border:2px solid var(--border);
                    display:flex;align-items:center;justify-content:center;flex-shrink:0;
                    transition:all 0.15s;
                    <%= is_generic ? 'border-color:var(--accent);background:var(--accent)' : '' %>">
          <% if is_generic %>
            <span style="width:6px;height:6px;background:#fff;border-radius:50%;display:block"></span>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>

<script>
  function onFileChosen(input) {
    var files = Array.from(input.files);
    if (!files.length) return;

    var chosen = document.getElementById('file-chosen');
    if (files.length === 1) {
      chosen.innerHTML =
        '<span style="font-family:var(--mono);font-size:12px;color:var(--accent)">' +
        escHtml(files[0].name) + ' (' + (files[0].size / 1024).toFixed(0) + ' KB)</span>';
    } else {
      var listItems = files.map(function(f) {
        return '<li style="font-family:var(--mono);font-size:11px;color:var(--accent);margin-bottom:2px">' +
               escHtml(f.name) + ' <span style="color:var(--text-dim)">(' + (f.size/1024).toFixed(0) + ' KB)</span></li>';
      }).join('');
      chosen.innerHTML =
        '<div style="font-size:12px;font-weight:600;color:var(--accent);margin-bottom:6px">' +
        files.length + ' files selected:</div>' +
        '<ul style="list-style:none;margin:0;padding:0;text-align:left">' + listItems + '</ul>';
    }
    chosen.style.display = 'block';

    var btn = document.getElementById('submit-btn');
    btn.disabled = false;
    btn.style.opacity = '1';
    document.getElementById('drop-zone').style.borderColor = 'var(--accent)';
    document.getElementById('drop-zone').style.background   = 'rgba(79,142,247,0.05)';
  }

  function escHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function onDragOver(e) {
    e.preventDefault();
    document.getElementById('drop-zone').style.borderColor = 'var(--accent)';
    document.getElementById('drop-zone').style.background   = 'rgba(79,142,247,0.08)';
  }
  function onDragLeave(e) {
    document.getElementById('drop-zone').style.borderColor = 'var(--accent-dim)';
    document.getElementById('drop-zone').style.background   = '';
  }
  function onDrop(e) {
    e.preventDefault();
    onDragLeave(e);
    var dt = e.dataTransfer;
    if (dt.files.length > 0) {
      var inp = document.getElementById('file-input');
      inp.files = dt.files;
      onFileChosen(inp);
    }
  }

  document.getElementById('upload-form').addEventListener('submit', function() {
    document.getElementById('submit-btn').disabled = true;
    document.getElementById('submit-btn').style.opacity = '0.6';
    document.getElementById('uploading-msg').style.display = 'inline';
  });

  // ── Supplier modal ───────────────────────────────────────────────────────
  var currentSlug = 'generic';

  function openSupplierModal() {
    document.getElementById('supplier-modal').classList.add('open');
  }

  function closeSupplierModal() {
    document.getElementById('supplier-modal').classList.remove('open');
  }

  function selectSupplier(slug, value, display, initials, colour, tagline) {
    currentSlug = slug;

    // Update hidden form field
    document.getElementById('supplier-hint-input').value = value;

    // Update badge bar
    var hex = colour.replace(/^#/, '');
    var r   = parseInt(hex.substring(0, 2), 16);
    var g   = parseInt(hex.substring(2, 4), 16);
    var b   = parseInt(hex.substring(4, 6), 16);
    var iconEl = document.getElementById('sup-badge-icon');
    iconEl.style.background  = 'rgba(' + r + ',' + g + ',' + b + ',0.12)';
    iconEl.style.color        = colour;
    iconEl.style.fontSize     = initials.length > 1 ? '11px' : '16px';
    iconEl.textContent        = initials;
    document.getElementById('sup-badge-name').textContent    = display;
    document.getElementById('sup-badge-tagline').textContent = tagline;

    // Update modal card selection state
    document.querySelectorAll('.modal-sup-card').forEach(function(card) {
      card.classList.remove('selected');
    });
    document.querySelectorAll('[id^="modal-check-"]').forEach(function(el) {
      el.style.borderColor = 'var(--border)';
      el.style.background  = '';
      el.innerHTML         = '';
    });
    var selCard  = document.getElementById('modal-card-'  + slug);
    var selCheck = document.getElementById('modal-check-' + slug);
    if (selCard)  selCard.classList.add('selected');
    if (selCheck) {
      selCheck.style.borderColor = 'var(--accent)';
      selCheck.style.background  = 'var(--accent)';
      selCheck.innerHTML = '<span style="width:6px;height:6px;background:#fff;border-radius:50%;display:block"></span>';
    }

    closeSupplierModal();
  }

  // Auto-open on page load
  window.addEventListener('load', function() { openSupplierModal(); });

  // Close when clicking the dark overlay
  document.getElementById('supplier-modal').addEventListener('click', function(e) {
    if (e.target === this) closeSupplierModal();
  });

  // Escape key closes
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSupplierModal();
  });
</script>
