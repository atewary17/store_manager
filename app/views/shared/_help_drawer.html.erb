        { element: '#live-grand-total', popover: { title: 'মোট টাকা', description: 'এডিট করার সাথে সাথে আপডেট হয়। এটি বিলে ছাপা মোটের সাথে মেলা উচিত।', side: 'top', align: 'start' } },
