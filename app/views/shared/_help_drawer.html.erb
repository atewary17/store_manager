      ]
    },
    'purchasing/purchase_invoices/new': {
      en: [
        { popover: { title: 'Enter a bill by hand', description: 'A quick tour of the purchase bill form. If you have a photo of the bill, Scan Invoice is faster.' } },
        { element: '#supplier-ac-wrap', popover: { title: 'Step 1 — Choose the supplier', description: 'Start typing the name and pick from the list. Their state decides whether the bill gets CGST + SGST or IGST.', side: 'bottom', align: 'start' } },
        { element: '#purchase_invoice_invoice_number', popover: { title: 'Step 2 — Bill details', description: 'Copy the invoice number exactly as printed, then set the invoice and delivery dates.', side: 'bottom', align: 'start' } },
