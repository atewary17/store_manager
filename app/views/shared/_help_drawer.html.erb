        { element: '[data-tour=col-desc]',    popover: { title: 'विवरण (Description)', description: 'बिल पर लिखा प्रोडक्ट का नाम। सही पढ़ा गया है या नहीं देखें ताकि सही प्रोडक्ट से मिले।', side: 'bottom', align: 'start' } },
        { element: '[data-tour=col-qty]',     popover: { title: 'मात्रा (Quantity)', description: 'कितनी इकाई (या पैक) बिल हुई। बिल से मिलाएँ।', side: 'bottom', align: 'start' } },
