        { element: '#save-btn',      popover: { title: 'Save the bill', description: 'When everything looks right, click here to save it as a draft purchase bill.', side: 'bottom', align: 'start' } }
      ],
      bn: [
        { popover: { title: 'স্ক্যান করা বিল যাচাই করুন', description: 'অ্যাপ বিলটি পড়ে ফেলেছে। তথ্য মিলিয়ে দেখুন, ভুল থাকলে ঠিক করুন, তারপর পারচেজ বিল হিসেবে সেভ করুন।' } },
        { element: '.preview-panel', popover: { title: 'আসল বিল', description: 'এটি আপনার আপলোড করা ছবি বা PDF। বড় করে দেখতে ক্লিক করুন এবং ডান পাশের মানের সাথে মিলিয়ে নিন।', side: 'right', align: 'start' } },
        { element: 'input[name="parsed_data[supplier][name]"]', popover: { title: 'সরবরাহকারীর নাম দেখুন', description: 'সরবরাহকারীর নাম বিলের সাথে মিলছে কিনা দেখুন। ভুল হলে ক্লিক করে ঠিক করুন।', side: 'bottom', align: 'start' } },
        { element: 'input[name="parsed_data[supplier][gstin]"]', popover: { title: 'GST নম্বর দেখুন', description: 'সরবরাহকারীর GSTIN মিলিয়ে নিন। সঠিক GSTIN থাকলে আপনার ইনপুট ট্যাক্স ক্রেডিট ঠিকভাবে নথিভুক্ত হয়।', side: 'bottom', align: 'start' } },
        { element: '.items-grid',    popover: { title: 'আইটেমগুলো দেখে নিন', description: 'অ্যাপ যে পণ্যগুলো পড়েছে, সারি ধরে ধরে। ভুল হলে যেকোনো ঘরে ক্লিক করে ঠিক করুন — মোট নিজে থেকেই আপডেট হবে।', side: 'top', align: 'start' } },
        { element: '[data-tour=col-desc]',    popover: { title: 'বিবরণ (Description)', description: 'বিলে লেখা পণ্যের নাম। ঠিকভাবে পড়া হয়েছে কিনা দেখুন যাতে সঠিক পণ্যের সাথে মেলে।', side: 'bottom', align: 'start' } },
        { element: '[data-tour=col-qty]',     popover: { title: 'পরিমাণ (Quantity)', description: 'কত একক (বা প্যাক) বিল করা হয়েছে। বিলের সাথে মিলিয়ে নিন।', side: 'bottom', align: 'start' } },
        { element: '[data-tour=col-taxable]', popover: { title: 'করযোগ্য মূল্য (Taxable)', description: 'ছাড়ের পরে, GST-র আগের পরিমাণ। এর উপরেই GST ধরা হয়।', side: 'bottom', align: 'start' } },
