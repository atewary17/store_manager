<%# Active session elsewhere — sign-in is blocked. Matches the sign-in page design. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account In Use — MyStore Manager</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <%= csrf_meta_tags %>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #0c1123; --navy2: #111829; --navy3: #192038;
      --blue: #4f8ef7; --blue2: #2563eb;
      --red:  #f7614f; --amber: #f59e0b; --teal: #34d98b;
      --text: #dde3f4; --muted: #6b7799; --dimmer: #3d4a6a;
      --border: rgba(79,142,247,0.12); --border2: rgba(79,142,247,0.22);
      --glow: rgba(79,142,247,0.18);
      --font: 'Inter', sans-serif; --mono: 'IBM Plex Mono', monospace;
    }
    html, body { height: 100%; }
    body {
      font-family: var(--font); background: var(--navy); color: var(--text);
      display: flex; min-height: 100vh; align-items: center; justify-content: center;
    }
    body::before {
      content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background-image:
        linear-gradient(rgba(79,142,247,0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(79,142,247,0.035) 1px, transparent 1px);
      background-size: 40px 40px;
    }
    .card {
      position: relative; z-index: 1;
      width: 100%; max-width: 420px; padding: 40px;
      background: var(--navy2); border: 1px solid rgba(247,97,79,0.3);
      border-top: 3px solid var(--red); border-radius: 14px;
      box-shadow: 0 0 60px rgba(247,97,79,0.08);
      animation: fadeUp 0.5s ease both;
    }
    .icon-wrap {
      width: 52px; height: 52px; border-radius: 12px;
      background: rgba(247,97,79,0.1); border: 1px solid rgba(247,97,79,0.25);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 20px; color: var(--red);
    }
    .eyebrow {
      font-family: var(--mono); font-size: 10px; letter-spacing: .18em;
      text-transform: uppercase; color: var(--red); margin-bottom: 10px;
    }
    h1 { font-size: 22px; font-weight: 700; letter-spacing: -.03em; margin-bottom: 8px; }
    .sub { font-size: 13px; color: var(--muted); line-height: 1.65; margin-bottom: 24px; }
    .info-row {
      display: flex; align-items: center; gap: 10px;
      background: rgba(247,97,79,0.06); border: 1px solid rgba(247,97,79,0.2);
      border-radius: 8px; padding: 12px 14px; margin-bottom: 24px;
      font-size: 12px; color: var(--text);
    }
    .info-row svg { flex-shrink: 0; color: var(--red); }
    .info-label { font-family: var(--mono); color: var(--muted); margin-right: 4px; }
    .btn-back {
      display: block; width: 100%; padding: 12px;
      background: var(--navy3); color: var(--text); border: 1px solid var(--border2);
      border-radius: 8px; font-size: 14px; font-weight: 600; text-align: center;
      text-decoration: none; cursor: pointer;
      transition: background .15s, border-color .15s;
    }
    .btn-back:hover { background: var(--navy); border-color: var(--blue); }
    .footer { text-align: center; font-size: 11px; color: var(--dimmer); margin-top: 20px; font-family: var(--mono); }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon-wrap">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
        <line x1="18" y1="8" x2="22" y2="12"/>
        <line x1="22" y1="8" x2="18" y2="12"/>
      </svg>
    </div>

    <div class="eyebrow">Session Conflict</div>
    <h1>Account Is Currently In Use</h1>
    <p class="sub">
      This account is actively being used on another device or browser.
      You cannot sign in while an active session exists.
    </p>

    <div class="info-row">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>
        <span class="info-label">Last active:</span>
        <%= time_ago_in_words(@other_active_at) %> ago
      </span>
    </div>

    <a href="<%= new_user_session_path %>" class="btn-back">← Back to Sign In</a>

    <div class="footer">
      Ask the other user to sign out, then try again.
    </div>
  </div>
</body>
</html>
