<%# app/views/reports/sales/_summary.html.erb %>

<%# KPI Cards %>
<div class="stats-row" style="grid-template-columns:repeat(4,1fr);margin-bottom:24px">
  <div class="stat-card">
    <div class="stat-label">Total Revenue</div>
    <div class="stat-value accent">₹<%= number_with_delimiter(@total_revenue.round(0)) %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Invoices Issued</div>
    <div class="stat-value"><%= @invoice_count %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Avg Invoice Value</div>
    <div class="stat-value" style="font-size:18px">₹<%= number_with_delimiter(@avg_invoice.round(0)) %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">GST Collected</div>
    <div class="stat-value" style="font-size:18px;color:var(--warning)">₹<%= number_with_delimiter(@total_tax.round(0)) %></div>
  </div>
</div>
<div class="stats-row" style="grid-template-columns:1fr 1fr;margin-bottom:24px">
  <div class="stat-card">
    <div class="stat-label">Collected</div>
    <div class="stat-value success" style="font-size:18px">₹<%= number_with_delimiter(@total_collected.round(0)) %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Still Outstanding</div>
    <div class="stat-value" style="font-size:18px;color:<%= @total_outstanding > 0 ? 'var(--warning)' : 'var(--success)' %>">
      ₹<%= number_with_delimiter(@total_outstanding.round(0)) %>
    </div>
  </div>
</div>

<%# Chart %>
<div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;
            padding:20px;margin-bottom:24px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
    <span style="font-size:13px;font-weight:500;color:var(--text)">Revenue over period</span>
    <%# Bar / Pulse toggle %>
    <div style="display:inline-flex;border:1px solid var(--border);border-radius:8px;overflow:hidden">
      <button type="button" class="chart-mode-btn" data-mode="bar"
              style="border:0;cursor:pointer;padding:5px 12px;font-size:12px;font-family:var(--mono);
                     background:transparent;color:var(--text-dim);display:flex;align-items:center;gap:5px">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M18 20V10M12 20V4M6 20V14"/></svg>
        Bars
      </button>
      <button type="button" class="chart-mode-btn" data-mode="pulse"
              style="border:0;cursor:pointer;padding:5px 12px;font-size:12px;font-family:var(--mono);
                     background:transparent;color:var(--text-dim);border-left:1px solid var(--border);
                     display:flex;align-items:center;gap:5px">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"
             viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12h4l2-6 4 12 2-7 2 1h6"/></svg>
        Pulse
      </button>
    </div>
  </div>
  <div id="chart-summary" style="height:280px"></div>
</div>

<%# Breakdown table %>
<div class="table-wrap">
  <div style="padding:12px 18px;border-bottom:1px solid var(--border)">
    <span style="font-family:var(--mono);font-size:10px;letter-spacing:.1em;
                 text-transform:uppercase;color:var(--text-dim)">
      Breakdown by <%= @group_by.titleize %>
    </span>
  </div>
  <table>
    <thead>
      <tr>
        <th>Period</th>
        <th style="text-align:right">Invoices</th>
        <th style="text-align:right">Revenue (₹)</th>
        <th style="text-align:right">Tax (₹)</th>
        <th style="text-align:right">Taxable (₹)</th>
      </tr>
    </thead>
    <tbody>
      <% if @breakdown.any? %>
        <% @breakdown.each do |row| %>
          <tr>
            <td style="font-family:var(--mono);font-size:12px">
              <% label = case @group_by
                         when 'day'   then row.period.strftime('%d %b %Y')
                         when 'week'  then "Week of #{row.period.strftime('%d %b %Y')}"
                         else              row.period.strftime('%B %Y')
                         end %>
              <%= label %>
            </td>
            <td style="text-align:right;font-family:var(--mono)"><%= row.inv_count %></td>
            <td style="text-align:right;font-family:var(--mono);color:var(--success)">
              <%= number_with_delimiter(row.revenue.to_f.round(2)) %>
            </td>
            <td style="text-align:right;font-family:var(--mono);color:var(--warning)">
              <%= number_with_delimiter(row.tax_total.to_f.round(2)) %>
            </td>
            <td style="text-align:right;font-family:var(--mono)">
              <%= number_with_delimiter((row.revenue.to_f - row.tax_total.to_f).round(2)) %>
            </td>
          </tr>
        <% end %>
        <tr style="background:var(--bg);font-weight:700">
          <td style="font-family:var(--mono);font-size:12px">Total</td>
          <td style="text-align:right;font-family:var(--mono)"><%= @invoice_count %></td>
          <td style="text-align:right;font-family:var(--mono);color:var(--success)">
            <%= number_with_delimiter(@total_revenue) %>
          </td>
          <td style="text-align:right;font-family:var(--mono);color:var(--warning)">
            <%= number_with_delimiter(@total_tax) %>
          </td>
          <td style="text-align:right;font-family:var(--mono)">
            <%= number_with_delimiter(@total_taxable) %>
          </td>
        </tr>
      <% else %>
        <tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text-dim)">
          No sales in this period.
        </td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  var chart = initChart('chart-summary');
  if (!chart) return;
  var labels = <%= raw @chart_labels.to_json %>;
  var data   = <%= raw @chart_data.to_json %>;
  var KEY    = 'salesSummaryChartMode';

  // Axes / tooltip shared by both views
  function commonOption(mode) {
    return Object.assign({}, EC_DARK, {
      tooltip: Object.assign({}, EC_DARK.tooltip, {
        trigger: 'axis',
        formatter: function(p) { return '<b>' + p[0].name + '</b><br/>' + inr(p[0].value); }
      }),
      xAxis: Object.assign({}, EC_DARK.xAxis, {
        type: 'category', data: labels,
        boundaryGap: mode === 'bar',   // bars need gaps; the pulse line sits on the edges
        axisLabel: { color: EC_COLORS.textDim, fontSize: 11, rotate: labels.length > 10 ? 30 : 0 }
      }),
      yAxis: Object.assign({}, EC_DARK.yAxis, {
        type: 'value',
        axisLabel: { formatter: function(v){ return inr(v); }, color: EC_COLORS.textDim, fontSize: 10 }
      })
    });
  }

  // Bar view
  function barOption() {
    var o = commonOption('bar');
    o.series = [{
      type: 'bar', data: data, name: 'Revenue', barMaxWidth: 48,
      itemStyle: {
        borderRadius: [4,4,0,0],
        color: new echarts.graphic.LinearGradient(0,0,0,1,
          [{offset:0, color:'#4f8ef7'},{offset:1, color:'#1e3a6e'}])
      },
      emphasis: { itemStyle: { color: '#6aadfb' } },
      label: {
        show: data.length <= 12, position: 'top',
        formatter: function(p){ return inr(p.value); },
        color: EC_COLORS.textDim, fontSize: 10
      }
    }];
    return o;
  }

  // Pulse view — glowing heartbeat-style area line
  function pulseOption() {
    var o = commonOption('pulse');
    o.series = [{
      type: 'line', data: data, name: 'Revenue',
      smooth: true, showSymbol: false, symbol: 'circle', symbolSize: 7,
      lineStyle: { width: 3, color: '#34d98b', cap: 'round',
                   shadowBlur: 12, shadowColor: 'rgba(52,217,139,0.6)' },
      itemStyle: { color: '#34d98b', borderColor: EC_COLORS.surface, borderWidth: 2 },
      areaStyle: {
        color: new echarts.graphic.LinearGradient(0,0,0,1,
          [{offset:0, color:'rgba(52,217,139,0.35)'},{offset:1, color:'rgba(52,217,139,0.01)'}])
      },
      emphasis: { focus: 'series' }
    }];
    return o;
  }

  function render(mode) {
    try { localStorage.setItem(KEY, mode); } catch (e) {}
    chart.setOption(mode === 'pulse' ? pulseOption() : barOption(), true);
    document.querySelectorAll('.chart-mode-btn').forEach(function(b) {
      var on = b.getAttribute('data-mode') === mode;
      b.style.background = on ? 'var(--accent-dim)' : 'transparent';
      b.style.color      = on ? 'var(--accent)'     : 'var(--text-dim)';
    });
  }

  document.querySelectorAll('.chart-mode-btn').forEach(function(b) {
    b.addEventListener('click', function() { render(b.getAttribute('data-mode')); });
  });

  var saved = 'bar';
  try { saved = localStorage.getItem(KEY) || 'bar'; } catch (e) {}
  render(saved);
  window.addEventListener('resize', function() { chart.resize(); });
});
</script>
