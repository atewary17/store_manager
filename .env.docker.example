# .env.docker.example — template for the Docker stack.
#
#   cp .env.docker.example .env
#
# Then fill in the real values. .env is gitignored and never enters the image
# (see .dockerignore); compose passes these in as environment variables at run
# time. config/application.rb reads local_env.yml with `ENV[key] ||= value`, so
# anything set here wins over that file.

# ── Rails ───────────────────────────────────────────────────────────────────
RAILS_ENV=production

# Generate with: bundle exec rails secret
# Changing this invalidates every existing session and signed cookie.
SECRET_KEY_BASE=replace_me

# Contents of config/master.key. Required only if the app reads encrypted
# credentials; master.key is deliberately excluded from the image.
RAILS_MASTER_KEY=replace_me

# Puma serves compiled assets itself. Required while nothing sits in front of
# it — with no proxy and this unset, every CSS and JS request 404s.
RAILS_SERVE_STATIC_FILES=true

# false for local HTTP testing. Leave unset (or true) in production, where a
# reverse proxy terminates TLS.
FORCE_SSL=false

RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=4
WEB_CONCURRENCY=2

# ── Database ────────────────────────────────────────────────────────────────
# Used by the db service. DATABASE_URL is built from it in docker-compose.yml.
POSTGRES_PASSWORD=devpassword

# ── Background jobs ─────────────────────────────────────────────────────────
# Set to external by docker-compose for both services; the worker container is
# what actually runs jobs. Listed here for visibility.
# GOOD_JOB_EXECUTION_MODE=external
GOOD_JOB_MAX_THREADS=3

# ── Invoice scanning ────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_replace_me

# Optional overrides. GROQ_VISION_MODEL lets you move off a deprecated model
# without a deploy; the pipeline default is qwen/qwen3.6-27b.
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Forces a scanning pipeline regardless of each organisation's setting. Use on
# development and staging, where the key is a free-tier key that cannot run the
# Standard pipeline. Never set this in production — it overrides every
# customer's configuration.
# INVOICE_SCAN_PIPELINE_FORCE=groq_qwen_vision_lite

# ── Email (Brevo) ───────────────────────────────────────────────────────────
BREVO_SMTP_LOGIN=replace_me
BREVO_SMTP_PASSWORD=replace_me
