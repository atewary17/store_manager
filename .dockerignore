# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Secrets — never copy into image layers.
# config/local_env.yml is gitignored, so it is absent from a clean clone, but
# COPY . . would pick it up on any machine where it exists (your laptop, the
# server). It holds GROQ_API_KEY and the Brevo SMTP password.
/config/local_env.yml

# Build context trimming — none of this is needed to run the app.
/spec/
/docs/
/.github/
/.claude/
